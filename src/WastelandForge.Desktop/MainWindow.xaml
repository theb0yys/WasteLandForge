            <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <TextBlock x:Name="PluginWorkbenchStatusTextBlock" Text="Select a project and refresh evidence." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
              <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <WrapPanel><Button x:Name="BuildPluginWorkbenchFomodButton" Content="Build FOMOD" Click="BuildPluginWorkbenchFomodClicked" /><Button x:Name="RunPluginWorkbenchCandidateButton" Content="Run Candidate Check" Margin="8,0,0,0" Click="RunPluginWorkbenchCandidateClicked" /><Button x:Name="CancelPluginWorkbenchActionButton" Content="Cancel" Margin="8,0,0,0" IsEnabled="False" Click="CancelPluginWorkbenchActionClicked" /></WrapPanel>
                <TextBox x:Name="PluginWorkbenchDetailsTextBox" Grid.Row="1" Margin="0,12,0,0" AcceptsReturn="True" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
