                <StackPanel x:Name="McmSliderFieldsPanel" Visibility="Collapsed">
                  <TextBlock Text="Default value" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="McmSliderDefaultTextBox" Text="1" Margin="0,6,0,0" TextChanged="McmAppendInputChanged" />
                  <TextBlock Text="Minimum" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="McmSliderMinimumTextBox" Text="0" Margin="0,6,0,0" TextChanged="McmAppendInputChanged" />
                  <TextBlock Text="Maximum" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="McmSliderMaximumTextBox" Text="10" Margin="0,6,0,0" TextChanged="McmAppendInputChanged" />
                  <TextBlock Text="Increment" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="McmSliderIncrementTextBox" Text="0.5" Margin="0,6,0,0" TextChanged="McmAppendInputChanged" />
                  <TextBlock Text="Decimal places" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="McmSliderDecimalsTextBox" Text="1" Margin="0,6,0,0" TextChanged="McmAppendInputChanged" />
                </StackPanel>
                <StackPanel x:Name="McmChoiceFieldsPanel" Visibility="Collapsed">
                  <TextBlock Text="Choices (one per line)" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" />
                  <TextBox x:Name="McmChoiceValuesTextBox" Text="Low&#x0a;Medium&#x0a;High" AcceptsReturn="True" Height="82" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" TextChanged="McmAppendInputChanged" />
                  <TextBlock Text="Default choice" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="McmChoiceDefaultTextBox" Text="Medium" Margin="0,6,0,0" TextChanged="McmAppendInputChanged" />
                </StackPanel>
                <StackPanel x:Name="McmKeybindFieldsPanel" Visibility="Collapsed">
                  <TextBlock Text="Default DirectX scancode" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="McmKeybindDefaultTextBox" Text="33" Margin="0,6,0,0" TextChanged="McmAppendInputChanged" />
                </StackPanel>
                <StackPanel x:Name="McmStaticTextFieldsPanel" Visibility="Collapsed">
                  <TextBlock Text="Displayed text" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="McmStaticTextTextBox" Text="Configuration changes apply immediately." AcceptsReturn="True" Height="64" TextWrapping="Wrap" Margin="0,6,0,0" TextChanged="McmAppendInputChanged" />
                </StackPanel>
                <StackPanel x:Name="McmStringToggleFieldsPanel" Visibility="Collapsed">
                  <TextBlock Text="On label (optional)" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="McmStringToggleTextOnTextBox" Text="Enabled" Margin="0,6,0,0" TextChanged="McmAppendInputChanged" />
                  <TextBlock Text="Off label (optional)" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="McmStringToggleTextOffTextBox" Text="Disabled" Margin="0,6,0,0" TextChanged="McmAppendInputChanged" />
                </StackPanel>
                <Button x:Name="CreateMcmSourceButton" Content="Create, Validate and Generate" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Click="CreateMcmSourceClicked" />
                <Button x:Name="LoadMcmSampleButton" Content="Load Sample Project" Margin="0,10,0,0" Click="LoadMcmSampleClicked" />
                <Button x:Name="PreviewMcmAppendButton" Content="Preview Append" Margin="0,10,0,0" Click="PreviewMcmAppendClicked" />
                <Button x:Name="AppendMcmSettingButton" Content="Append, Validate and Generate" Margin="0,10,0,0" IsEnabled="False" Click="AppendMcmSettingClicked" />
                <TextBlock x:Name="McmAuthorStatusTextBlock" Text="Ready to create a new MCM source registry." Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
            <TextBox x:Name="McmAuthorOutputTextBox" Grid.Column="1" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsReadOnly="True" TextWrapping="NoWrap" />
          </Grid>
        </TabItem>

