{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wastelandforge.dev/fnv/geck-placement-evidence/0.1.0/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "game", "captureMethod", "geckProviderSha256", "cell", "position", "rotation", "operatorStatement", "attestation", "limitations"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "kind": { "const": "geck-placement-evidence" },
    "game": { "const": "falloutnv" },
    "captureMethod": { "const": "human-geck-inspection" },
    "geckProviderSha256": { "$ref": "#/$defs/digest" },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolutionId", "kind", "editorId", "formId", "signature"],
      "properties": {
        "resolutionId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["cell", "worldspace"] },
        "editorId": { "type": "string", "minLength": 1 },
        "formId": { "type": "string", "pattern": "^[A-F0-9]{8}$" },
        "signature": { "type": "string", "pattern": "^[A-Z0-9_]{4}$" }
      }
    },
    "position": { "$ref": "#/$defs/vector" },
    "rotation": { "$ref": "#/$defs/vector" },
    "operatorStatement": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suitabilityHumanReviewed", "forgeObservedGeck", "providerCompatibilityProven", "pluginSavedDuringCapture", "verificationPerformed"],
      "properties": {
        "suitabilityHumanReviewed": { "const": true },
        "forgeObservedGeck": { "const": false },
        "providerCompatibilityProven": { "const": false },
        "pluginSavedDuringCapture": { "const": false },
        "verificationPerformed": { "const": false }
      }
    },
    "limitations": {
      "const": [
        "operator-attested-not-machine-observed",
        "placement-suitability-not-independently-verified",
        "provider-compatibility-not-proven",
        "plugin-not-saved-or-verified"
      ]
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    }
  }
}
