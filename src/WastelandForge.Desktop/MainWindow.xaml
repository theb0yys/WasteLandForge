            <StackPanel><TextBlock Text="Human-authored plugin intake" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Import opaque ESP/ESM bytes into project source. Forge does not parse or edit plugin records." Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" /></StackPanel>
            <Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="PluginSourcePathTextBox" Padding="8" TextChanged="PluginIntakeInputChanged" /><Button Grid.Column="1" Content="Browse Plugin" Margin="8,0,0,0" Click="BrowsePluginArtifactClicked" /></Grid>
            <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBox x:Name="PluginArtifactIdTextBox" Padding="8" TextChanged="PluginIntakeInputChanged" ToolTip="Dotted lowercase plugin artifact ID" /><ComboBox x:Name="PluginAuthoringToolComboBox" Grid.Column="1" Margin="8,0,0,0" Padding="8" SelectionChanged="PluginIntakeInputChanged"><ComboBoxItem Content="geck" IsSelected="True" /><ComboBoxItem Content="xedit" /><ComboBoxItem Content="other" /></ComboBox></Grid>
            <WrapPanel Grid.Row="3" Margin="0,12,0,10"><Button Content="Preview Import" Click="PreviewPluginArtifactClicked" /><Button x:Name="ImportPluginArtifactButton" Content="Import Plugin" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="ImportPluginArtifactClicked" /><TextBlock x:Name="PluginIntakeStatusTextBlock" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Text="Select an ESP or ESM to begin." /></WrapPanel>
            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
              <TextBox x:Name="PluginIntakeDetailsTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" Padding="10" />
              <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Attach xEdit review evidence" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                <Button x:Name="LoadPendingPluginsButton" Content="Load Pending Plugins" HorizontalAlignment="Left" Margin="0,8,0,0" Click="LoadPendingPluginsClicked" />
                <ComboBox x:Name="PluginReviewArtifactComboBox" Margin="0,8,0,0" DisplayMemberPath="DataPath" SelectionChanged="PluginReviewInputChanged" />
                <WrapPanel Margin="0,8,0,0"><Button x:Name="PreviewXEditLaunchButton" Content="Preview xEdit Launch" IsEnabled="False" Click="PreviewXEditLaunchClicked" /><Button x:Name="LaunchXEditButton" Content="Launch xEdit" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="LaunchXEditClicked" /><Button x:Name="PreviewXEditMo2RequestButton" Content="Preview MO2 Request" Margin="8,0,0,0" IsEnabled="False" Click="PreviewXEditMo2RequestClicked" /><Button x:Name="CreateXEditMo2RequestButton" Content="Create MO2 Request" Margin="8,0,0,0" IsEnabled="False" Click="CreateXEditMo2RequestClicked" /></WrapPanel>
                <TextBox x:Name="XEditLaunchDetailsTextBox" Height="120" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="PluginReviewReportPathTextBox" Padding="8" TextChanged="PluginReviewInputChanged" /><Button Grid.Column="1" Content="Browse Report" Margin="8,0,0,0" Click="BrowsePluginReviewReportClicked" /></Grid>
                <TextBox x:Name="PluginReviewerTextBox" Margin="0,8,0,0" Padding="8" ToolTip="Reviewer project identity" TextChanged="PluginReviewInputChanged" />
                <CheckBox x:Name="PluginReviewApprovalCheckBox" Margin="0,10,0,0" Content="I accept the review statement and release responsibility" Checked="PluginReviewInputChanged" Unchecked="PluginReviewInputChanged" />
                <WrapPanel Margin="0,10,0,0"><Button Content="Preview Review" Click="PreviewPluginReviewClicked" /><Button x:Name="PromotePluginReviewButton" Content="Promote to Reviewed" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="PromotePluginReviewClicked" /></WrapPanel>
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem x:Name="GeckHandoffTabItem" Header="GECK Handoff">
          <TabControl x:Name="GeckAuthoringModeTabControl" SelectedIndex="0">
            <TabItem x:Name="GeckAuthoringReviewTabItem" Header="Authoring Plan &amp; Verification">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,18,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="GECK authoring evidence" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="SemiBold" />
                      <TextBlock Text="Plan canonical intent, prepare the read-only observer, and seal manually collected evidence." Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="RefreshGeckAuthoringReviewButton" Grid.Column="1" Content="Refresh Evidence" Click="RefreshGeckAuthoringReviewClicked" />
                    <Button x:Name="CancelGeckAuthoringOperationButton" Grid.Column="2" Content="Cancel" Margin="8,0,0,0" IsEnabled="False" Click="CancelGeckAuthoringOperationClicked" />
                  </Grid>

                  <TextBlock Text="Forge generates a read-only observer bundle. FNVEdit execution and script installation are manual; Gate 534 compatibility remains unproven." Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" TextWrapping="Wrap" />

                  <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="1. Intent and plan" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Resolve canonical intent into a deterministic, plugin-write-free authoring plan." Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel>
                    <TextBlock x:Name="GeckAuthoringPlanStateTextBlock" Grid.Column="1" Text="NotLoaded" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </Grid>
                  <WrapPanel Margin="0,8,0,0"><Button x:Name="PreviewGeckAuthoringPlanButton" Content="Preview Plan" IsEnabled="False" Click="PreviewGeckAuthoringPlanClicked" /><Button x:Name="GenerateGeckAuthoringPlanButton" Content="Generate Plan" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="GenerateGeckAuthoringPlanClicked" /></WrapPanel>

                  <Border Margin="0,16,0,0" BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,1,0,0" />
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="2. Read-only observer" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Generate the deterministic Pascal observer bundle bound to the current plan." Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel>
                    <TextBlock x:Name="GeckAuthoringVerifierStateTextBlock" Grid.Column="1" Text="Locked" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </Grid>
                  <WrapPanel Margin="0,8,0,0"><Button x:Name="PreviewGeckAuthoringVerifierButton" Content="Preview Observer" IsEnabled="False" Click="PreviewGeckAuthoringVerifierClicked" /><Button x:Name="GenerateGeckAuthoringVerifierButton" Content="Generate Observer" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="GenerateGeckAuthoringVerifierClicked" /></WrapPanel>

                  <Border Margin="0,16,0,0" BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,1,0,0" />
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="3. Raw observations" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Select the project-contained JSON written by the manually run observer." Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel>
                    <TextBlock x:Name="GeckAuthoringObservationsStateTextBlock" Grid.Column="1" Text="Required" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </Grid>
                  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="GeckAuthoringObservationsPathTextBox" Padding="8" TextChanged="GeckAuthoringObservationsPathChanged" /><Button x:Name="BrowseGeckAuthoringObservationsButton" Grid.Column="1" Content="Browse JSON" Margin="8,0,0,0" Click="BrowseGeckAuthoringObservationsClicked" /></Grid>

                  <Border Margin="0,16,0,0" BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,1,0,0" />
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="4. Semantic verification" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Preview the exact semantic comparison, then explicitly seal the verified report." Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel>
                    <TextBlock x:Name="GeckAuthoringVerificationStateTextBlock" Grid.Column="1" Text="Locked" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </Grid>
                  <WrapPanel Margin="0,8,0,0"><Button x:Name="PreviewGeckAuthoringVerificationButton" Content="Preview Verification" IsEnabled="False" Click="PreviewGeckAuthoringVerificationClicked" /><Button x:Name="GenerateGeckAuthoringVerificationButton" Content="Seal Verification Report" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="GenerateGeckAuthoringVerificationClicked" /></WrapPanel>

                  <TextBlock Text="Current evidence" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,18,0,0" />
                  <TextBox x:Name="GeckAuthoringEvidenceTextBox" Height="120" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11" />

                  <TextBlock Text="Diagnostics" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,16,0,0" />
                  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <DataGrid x:Name="GeckAuthoringDiagnosticsDataGrid" Height="160" Margin="0,0,8,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="GeckAuthoringDiagnosticSelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="120" /><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80" /><DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="120" /><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" /></DataGrid.Columns></DataGrid>
                    <TextBox x:Name="GeckAuthoringDiagnosticDetailTextBox" Grid.Column="1" Height="160" Margin="8,0,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" />
                  </Grid>

                  <WrapPanel Margin="0,16,0,0"><Button x:Name="RouteGeckManualHandoffButton" Content="Manual Handoff" Click="RouteGeckManualHandoffClicked" /><Button x:Name="RouteGeckXEditAuditButton" Content="xEdit Audit" Margin="8,0,0,0" Click="RouteGeckXEditAuditClicked" /><Button x:Name="RouteGeckProjectOutputsButton" Content="Project Outputs" Margin="8,0,0,0" Click="RouteGeckProjectOutputsClicked" /><Button x:Name="RouteGeckValidationButton" Content="Validation" Margin="8,0,0,0" Click="RouteGeckValidationClicked" /></WrapPanel>
                  <TextBlock x:Name="GeckAuthoringStatusTextBlock" Text="Select a Forge project and refresh authoring evidence." Foreground="{StaticResource TextMuted}" Margin="0,12,0,18" TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem x:Name="GeckManualHandoffTabItem" Header="Manual Handoff">
          <Grid Margin="0,18,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="GECK authoring handoff" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Review generated work and explicitly launch the configured GECK executable. Plugin work remains manual." Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" /></StackPanel>
              <Button x:Name="LoadGeckHandoffButton" Grid.Column="1" Content="Load Handoff" Click="LoadGeckHandoffWorkspaceClicked" />
              <Button x:Name="OpenGeckWorkspaceFolderButton" Grid.Column="2" Content="Open Output Folder" Margin="8,0,0,0" IsEnabled="False" Click="OpenGeckWorkspaceFolderClicked" />
              <Button x:Name="OpenGeckWorkspaceWorklistButton" Grid.Column="3" Content="Open Task Worklist" Margin="8,0,0,0" IsEnabled="False" Click="OpenGeckWorkspaceWorklistClicked" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,12,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="GeckTaskSearchTextBox" Padding="8" ToolTip="Filter GECK tasks" TextChanged="GeckTaskFilterChanged" />
              <ComboBox x:Name="GeckTaskCategoryComboBox" Grid.Column="1" Margin="8,0,0,0" Padding="8" SelectionChanged="GeckTaskFilterChanged" />
              <ComboBox x:Name="GeckTaskStatusComboBox" Grid.Column="2" Margin="8,0,0,0" Padding="8" SelectionChanged="GeckTaskFilterChanged"><ComboBoxItem Content="All" IsSelected="True" /><ComboBoxItem Content="Pending" /><ComboBoxItem Content="Completed" /></ComboBox>
              <TextBlock x:Name="GeckTaskCountTextBlock" Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Text="0 / 0" />
            </Grid>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
              <DataGrid x:Name="GeckHandoffTasksDataGrid" Margin="0,0,10,10" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="GeckTaskSelectionChanged">
                <DataGrid.Columns><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" /><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" /><DataGridTextColumn Header="Owner" Binding="{Binding OwnerId}" Width="160" /><DataGridTextColumn Header="Required action" Binding="{Binding RequiredAction}" Width="*" /></DataGrid.Columns>
              </DataGrid>
              <Grid Grid.Column="1" Margin="10,0,0,10">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBox x:Name="GeckTaskDetailTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" />
                <WrapPanel Grid.Row="1" Margin="0,8,0,0"><Button x:Name="CompleteGeckTaskButton" Content="Mark Complete" IsEnabled="False" Click="CompleteGeckTaskClicked" /><Button x:Name="ReopenGeckTaskButton" Content="Reopen" Margin="8,0,0,0" IsEnabled="False" Click="ReopenGeckTaskClicked" /></WrapPanel>
              </Grid>
            </Grid>
            <TextBlock Grid.Row="3" Text="Source provenance" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
            <DataGrid x:Name="GeckHandoffSourcesDataGrid" Grid.Row="4" Margin="0,8,0,10" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
              <DataGrid.Columns><DataGridTextColumn Header="State" Binding="{Binding Status}" Width="90" /><DataGridTextColumn Header="Source path" Binding="{Binding Path}" Width="*" /><DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="360" /><DataGridTextColumn Header="Bytes" Binding="{Binding Length}" Width="90" /></DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="5" Margin="0,4,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <WrapPanel><Button x:Name="PreviewGeckLaunchButton" Content="Preview GECK Launch" IsEnabled="False" Click="PreviewGeckLaunchClicked" /><Button x:Name="LaunchGeckButton" Content="Launch GECK" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="LaunchGeckClicked" /><Button x:Name="PreviewGeckMo2RequestButton" Content="Preview MO2 Request" Margin="8,0,0,0" IsEnabled="False" Click="PreviewGeckMo2RequestClicked" /><Button x:Name="CreateGeckMo2RequestButton" Content="Create MO2 Request" Margin="8,0,0,0" IsEnabled="False" Click="CreateGeckMo2RequestClicked" /></WrapPanel>
              <TextBox x:Name="GeckLaunchDetailsTextBox" Grid.Column="1" Height="92" Margin="12,0,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
            </Grid>
            <TextBlock x:Name="GeckHandoffWorkspaceStatusTextBlock" Grid.Row="6" Text="Load a completed GECK handoff to inspect its tasks and provenance." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
          </Grid>
            </TabItem>
          </TabControl>
        </TabItem>

        <TabItem x:Name="ReleaseCandidateTabItem" Header="Release Candidate">
          <Grid Margin="0,18,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="150" /><RowDefinition Height="*" /><RowDefinition Height="145" /><RowDefinition Height="Auto" /><RowDefinition Height="180" /><RowDefinition Height="210" /></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Release Candidate" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Local validation, FOMOD distributable, release verification, and prepared release archive" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
              </StackPanel>
              <Button x:Name="RunReleaseCandidateButton" Grid.Column="1" Content="Run Release Candidate Check" Style="{StaticResource PrimaryButton}" Click="RunReleaseCandidateClicked" />
              <Button x:Name="CancelReleaseCandidateButton" Grid.Column="2" Content="Cancel" Margin="8,0,0,0" IsEnabled="False" Click="CancelReleaseCandidateClicked" />
            </Grid>
            <Border Grid.Row="1" Margin="0,14,0,0" Padding="12" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ReleaseCandidateStateTextBlock" Text="Not run" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="ReleaseCandidateMessageTextBlock" Grid.Column="1" Text="Run the check to produce and verify a local candidate." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <DataGrid x:Name="ReleaseCandidateStagesDataGrid" Grid.Row="2" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Stage" Binding="{Binding Name}" Width="180" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                <DataGridTextColumn Header="Exit" Binding="{Binding ExitCode}" Width="60" />
                <DataGridTextColumn Header="Errors" Binding="{Binding Errors}" Width="70" />
                <DataGridTextColumn Header="Warnings" Binding="{Binding Warnings}" Width="80" />
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="65" />
                <DataGridTextColumn Header="Duration ms" Binding="{Binding DurationMilliseconds}" Width="100" />
                <DataGridTextColumn Header="Canonical command" Binding="{Binding Command}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="3" Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
              <DataGrid x:Name="ReleaseCandidateDiagnosticsDataGrid" Margin="0,0,6,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="ReleaseCandidateDiagnosticSelectionChanged">
                <DataGrid.Columns><DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="130" /><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80" /><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="180" /><DataGridTextColumn Header="Exact message" Binding="{Binding Message}" Width="*" /></DataGrid.Columns>
              </DataGrid>
              <DataGrid x:Name="ReleaseCandidatePluginsDataGrid" Grid.Column="1" Margin="6,0,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns><DataGridTextColumn Header="Plugin path" Binding="{Binding DataPath}" Width="*" /><DataGridTextColumn Header="Review" Binding="{Binding ReviewStatus}" Width="90" /><DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="220" /><DataGridTextColumn Header="Evidence digest" Binding="{Binding EvidenceSha256}" Width="220" /><DataGridTextColumn Header="Report digest" Binding="{Binding ReportSha256}" Width="220" /></DataGrid.Columns>
              </DataGrid>
            </Grid>
            <Grid Grid.Row="4" Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Selected diagnostic" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                <TextBlock x:Name="DiagnosticOriginalContextTextBlock" Margin="0,6,0,0" Foreground="{StaticResource TextMuted}" Text="Select a blocking diagnostic to inspect its exact context." TextWrapping="Wrap" />
                <WrapPanel Margin="0,10,0,0">
                  <Button x:Name="ExplainReleaseCandidateDiagnosticButton" Content="Explain Diagnostic" IsEnabled="False" Click="ExplainReleaseCandidateDiagnosticClicked" />
                  <Button x:Name="GoToDiagnosticWorkspaceButton" Content="Go to Workspace" Margin="8,0,0,0" IsEnabled="False" Click="GoToDiagnosticWorkspaceClicked" />
                </WrapPanel>
              </StackPanel>
              <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock x:Name="DiagnosticExplanationStatusTextBlock" Text="Not loaded" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" />
                <TextBox x:Name="DiagnosticExplanationTextBox" Grid.Row="1" Margin="0,6,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
              </Grid>
            </Grid>
            <WrapPanel Grid.Row="5" Margin="0,12,0,0">
              <Button x:Name="OpenCandidateFomodFolderButton" Content="Open Distributable Folder" IsEnabled="False" Click="OpenCandidateFomodFolderClicked" />
              <Button x:Name="OpenCandidateFomodArchiveButton" Content="Open FOMOD ZIP" Margin="8,0,0,0" IsEnabled="False" Click="OpenCandidateFomodArchiveClicked" />
              <Button x:Name="OpenCandidateBsaPlanFolderButton" Content="Open BSA Plan" Margin="8,0,0,0" IsEnabled="False" Click="OpenCandidateBsaPlanFolderClicked" />
              <Button x:Name="OpenCandidateBsaPlanReportButton" Content="Open BSA Report" Margin="8,0,0,0" IsEnabled="False" Click="OpenCandidateBsaPlanReportClicked" />
              <Button x:Name="OpenCandidatePackageFolderButton" Content="Open Combined Payload" Margin="8,0,0,0" IsEnabled="False" Click="OpenCandidatePackageFolderClicked" />
              <Button x:Name="OpenCandidatePackageArchiveButton" Content="Open Combined ZIP" Margin="8,0,0,0" IsEnabled="False" Click="OpenCandidatePackageArchiveClicked" />
              <Button x:Name="OpenCandidateReleaseEvidenceButton" Content="Open Release Evidence" Margin="8,0,0,0" IsEnabled="False" Click="OpenCandidateReleaseEvidenceClicked" />
              <Button x:Name="OpenCandidateReleaseHandoffButton" Content="Open Release Handoff" Margin="8,0,0,0" IsEnabled="False" Click="OpenCandidateReleaseHandoffClicked" />
              <Button x:Name="OpenCandidatePreparedFolderButton" Content="Open Prepared Release" Margin="8,0,0,0" IsEnabled="False" Click="OpenCandidatePreparedFolderClicked" />
              <Button x:Name="OpenCandidatePreparedArchiveButton" Content="Open Release ZIP" Margin="8,0,0,0" IsEnabled="False" Click="OpenCandidatePreparedArchiveClicked" />
            </WrapPanel>
            <Border Grid.Row="6" Margin="0,12,0,0" Padding="12" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="Local Release Handoff" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="0,8,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="LocalReleaseDestinationTextBox" Padding="8" TextChanged="LocalReleaseDestinationChanged" ToolTip="Existing destination folder" />
                  <Button Grid.Column="1" Content="Browse" Margin="8,0" Click="BrowseLocalReleaseDestinationClicked" />
                  <Button x:Name="PreviewLocalReleaseHandoffButton" Grid.Column="2" Content="Preview Handoff" IsEnabled="False" Click="PreviewLocalReleaseHandoffClicked" />
                  <Button x:Name="CreateLocalReleaseHandoffButton" Grid.Column="3" Content="Create Handoff" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="CreateLocalReleaseHandoffClicked" />
                  <Button x:Name="VerifyLocalReleaseHandoffButton" Grid.Column="4" Content="Verify Existing" Margin="8,0,0,0" IsEnabled="False" Click="VerifyLocalReleaseHandoffClicked" />
                  <Button x:Name="OpenLocalReleaseHandoffButton" Grid.Column="5" Content="Open Destination" Margin="8,0,0,0" IsEnabled="False" Click="OpenLocalReleaseHandoffClicked" />
                </Grid>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                  <TextBlock x:Name="LocalReleaseHandoffStatusTextBlock" Text="Create from a fresh Candidate, or select a handoff folder to verify existing files." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                  <TextBox x:Name="LocalReleaseHandoffDetailsTextBox" Grid.Column="1" Margin="12,0,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                </Grid>
              </Grid>
            </Border>
            <Border Grid.Row="7" Margin="0,12,0,0" Padding="12" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="Prepare MO2 Test Copy" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="0,8,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="CandidateMo2ModsRootTextBox" Padding="8" TextChanged="CandidateMo2InputChanged" ToolTip="Existing MO2 mods folder" />
                  <Button Grid.Column="1" Content="Browse" Margin="8,0" Click="BrowseCandidateMo2ModsRootClicked" />
                  <TextBox x:Name="CandidateMo2ModNameTextBox" Grid.Column="2" Padding="8" TextChanged="CandidateMo2InputChanged" ToolTip="New single-segment MO2 mod name" />
                  <Button x:Name="PreviewCandidateMo2TestCopyButton" Grid.Column="3" Content="Preview Test Copy" Margin="8,0,0,0" IsEnabled="False" Click="PreviewCandidateMo2TestCopyClicked" />
                  <Button x:Name="CreateCandidateMo2TestCopyButton" Grid.Column="4" Content="Create Test Copy" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="CreateCandidateMo2TestCopyClicked" />
                  <Button x:Name="OpenCandidateMo2TestCopyButton" Grid.Column="5" Content="Open Test Copy" Margin="8,0,0,0" IsEnabled="False" Click="OpenCandidateMo2TestCopyClicked" />
                </Grid>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                  <TextBlock x:Name="CandidateMo2TestCopyStatusTextBlock" Text="Run a fresh Release Candidate check before preparing a test copy. Enable and order the completed copy manually in MO2." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                  <TextBox x:Name="CandidateMo2TestCopyDetailsTextBox" Grid.Column="1" Margin="12,0,0,0" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <TabItem x:Name="AdvancedLogsTabItem" Header="Advanced Logs">
          <Grid Margin="0,18,0,0">
            <TextBox x:Name="LogsTextBox"
                     AcceptsReturn="True"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="13"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     TextWrapping="NoWrap" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
