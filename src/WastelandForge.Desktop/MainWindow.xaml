<Window x:Class="WastelandForge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WastelandForge"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        Background="{StaticResource AppBackground}"
        Loaded="OnLoaded">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="278" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="#12151A"
            BorderBrush="#303741"
            BorderThickness="0,0,1,0">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
          <Grid Width="72" Height="72" HorizontalAlignment="Left">
            <Ellipse Fill="#1D232A" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
            <TextBlock Text="WF"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Image x:Name="HeatAccentImage"
                   Stretch="Uniform"
                   Opacity="0.42"
                   Visibility="Collapsed" />
          </Grid>

          <TextBlock Text="WastelandForge"
                     Foreground="{StaticResource TextPrimary}"
                     FontSize="28"
                     FontWeight="Bold"
                     Margin="0,18,0,0" />
          <TextBlock Text="Premium Windows shell over the deterministic Forge backend."
                     Foreground="{StaticResource TextMuted}"
                     Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,34,0,0">
          <TextBlock Text="Shell"
                     Foreground="{StaticResource TextMuted}"
                     FontSize="12"
                     FontWeight="Bold" />
          <TextBlock x:Name="BackendStatusTextBlock"
                     Text="Backend not checked"
                     Foreground="{StaticResource TextPrimary}"
                     Margin="0,8,0,0" />
          <TextBlock x:Name="HeatStatusTextBlock"
                     Text="Heat UI skin not checked"
                     Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,36,0,0">
          <Button x:Name="RefreshButton"
                  Content="Refresh Backend"
                  Click="RefreshBackendClicked" />
          <Button Content="Open Publish Folder"
                  Margin="0,10,0,0"
                  Click="OpenPublishFolderClicked" />
        </StackPanel>

        <StackPanel Grid.Row="3">
          <TextBlock Text="forge.exe"
                     Foreground="{StaticResource TextMuted}"
                     FontSize="12"
                     FontWeight="Bold" />
          <TextBlock x:Name="ForgePathTextBlock"
                     Text="Resolving..."
                     Margin="0,8,0,0"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="30,28,30,28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock Text="Project command center"
                     Foreground="{StaticResource TextPrimary}"
                     FontSize="30"
                     FontWeight="Bold" />
          <TextBlock Text="Run Doctor readiness, capability catalogue checks, and validation without exposing a console window."
                     Foreground="{StaticResource TextMuted}"
                     Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Column="1"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderMuted}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="Backend version"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12"
                       FontWeight="Bold" />
            <TextBlock x:Name="VersionTextBlock"
                       Text="Pending"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15"
                       Margin="0,5,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="1"
              Margin="0,24,0,20"
              Background="{StaticResource PanelBackground}"
              BorderBrush="{StaticResource BorderMuted}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Project root"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12"
                       FontWeight="Bold" />
            <TextBox x:Name="ProjectPathTextBox"
                     Margin="0,8,0,0"
                     MinWidth="420" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="Browse"
                  Margin="14,21,0,0"
                  VerticalAlignment="Top"
                  Click="BrowseProjectClicked" />
          <Button x:Name="ValidateButton"
                  Grid.Column="2"
                  Content="Validate"
                  Style="{StaticResource PrimaryButton}"
                  Margin="10,21,0,0"
                  VerticalAlignment="Top"
                  Click="ValidateProjectClicked" />
        </Grid>
      </Border>

      <TabControl Grid.Row="2">
        <TabItem Header="Dashboard">
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,14,0">
              <StackPanel>
                <TextBlock Text="Backend"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="Bold" />
                <TextBlock x:Name="BackendDetailTextBlock"
                           Text="Waiting for forge.exe --version"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0" />
                <TextBlock Text="The app shell talks to the bundled Forge executable instead of duplicating validation logic."
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,12,0,0" />
              </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,14,0">
              <StackPanel>
                <TextBlock Text="Capabilities"
                           Foreground="{StaticResource InfoBrush}"
                           FontWeight="Bold" />
                <TextBlock x:Name="CapabilityStatusTextBlock"
                           Text="Waiting for capabilities list"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0" />
                <TextBlock x:Name="CapabilitySummaryTextBlock"
                           Text="No catalogue response yet."
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,12,0,0" />
              </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
              <StackPanel>
                <TextBlock Text="Validation"
                           Foreground="{StaticResource OkBrush}"
                           FontWeight="Bold" />
                <TextBlock x:Name="ValidationStatusTextBlock"
                           Text="Not run"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0" />
                <TextBlock x:Name="ValidationSummaryTextBlock"
                           Text="Select a project and run validation."
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,12,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="Validation Report">
          <Grid Margin="0,18,0,0">
            <TextBox x:Name="ValidationOutputTextBox"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="13"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     TextWrapping="NoWrap" />
          </Grid>
        </TabItem>

        <TabItem Header="Capabilities">
          <Grid Margin="0,18,0,0">
            <TextBox x:Name="CapabilityJsonTextBox"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="13"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     TextWrapping="NoWrap" />
          </Grid>
        </TabItem>

        <TabItem Header="Advanced Logs">
          <Grid Margin="0,18,0,0">
            <TextBox x:Name="LogsTextBox"
                     AcceptsReturn="True"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="13"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     TextWrapping="NoWrap" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
