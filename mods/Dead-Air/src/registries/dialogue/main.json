{"schemaVersion":"0.23.0","kind":"dialogue","id":"io.github.theboyyss.deadair.dialogue","topics":[{"id":"io.github.theboyyss.deadair.topic.mara.greeting","title":"Mara Voss greeting","summary":"Opening conversation at Lone Wolf Radio."},{"id":"io.github.theboyyss.deadair.topic.mara.broadcast","title":"The midnight broadcast","summary":"Questions about the signal and its victims."},{"id":"io.github.theboyyss.deadair.topic.mara.agreement","title":"Agree to investigate","summary":"The Courier accepts Mara's request."},{"id":"io.github.theboyyss.deadair.topic.mara.refusal","title":"Refuse the investigation","summary":"The Courier declines without permanently blocking the quest."},{"id":"io.github.theboyyss.deadair.topic.mara.firstvictim","title":"The first predicted death","summary":"Mara identifies Corporal Eli Venn and the first prediction target."}],"questGates":[{"id":"io.github.theboyyss.deadair.dialogue.gate.opening","questId":"io.github.theboyyss.deadair.quest.deadair","conditions":[{"id":"io.github.theboyyss.deadair.dialogue.gate.opening.condition.receiver","conditionType":"questStageDone","stageId":"io.github.theboyyss.deadair.quest.deadair.stage.lonewolfradio","summary":"Opening dialogue is available after the receiver is inspected."},{"id":"io.github.theboyyss.deadair.dialogue.gate.opening.condition.phasezero","conditionType":"questVariableEquals","variableId":"io.github.theboyyss.deadair.quest.deadair.variable.openingphase","equalsInteger":0,"summary":"The investigation has not yet been accepted."}],"summary":"Controls Mara's initial offer without allowing repeated acceptance."},{"id":"io.github.theboyyss.deadair.dialogue.gate.firstvictim","questId":"io.github.theboyyss.deadair.quest.deadair","conditions":[{"id":"io.github.theboyyss.deadair.dialogue.gate.firstvictim.condition.accepted","conditionType":"questStageDone","stageId":"io.github.theboyyss.deadair.quest.deadair.stage.meetmara","summary":"The first-victim briefing is available after acceptance."},{"id":"io.github.theboyyss.deadair.dialogue.gate.firstvictim.condition.phaseone","conditionType":"questVariableEquals","variableId":"io.github.theboyyss.deadair.quest.deadair.variable.openingphase","equalsInteger":1,"summary":"The opening acceptance handoff has completed."}],"summary":"Controls Mara's briefing about Corporal Eli Venn."}],"lines":[{"id":"io.github.theboyyss.deadair.dialogue.mara.greeting.first","questId":"io.github.theboyyss.deadair.quest.deadair","topicId":"io.github.theboyyss.deadair.topic.mara.greeting","speaker":"DANPCMaraVoss","responseText":"You heard it too. Good. Means I'm not losing my mind—or at least not alone.","priority":50,"conditions":[{"id":"io.github.theboyyss.deadair.dialogue.mara.greeting.first.condition.receiver","conditionType":"questStageDone","stageId":"io.github.theboyyss.deadair.quest.deadair.stage.lonewolfradio","summary":"The emergency receiver has been inspected."},{"id":"io.github.theboyyss.deadair.dialogue.mara.greeting.first.condition.openingzero","conditionType":"questVariableEquals","variableId":"io.github.theboyyss.deadair.quest.deadair.variable.openingphase","equalsInteger":0,"summary":"The opening investigation has not yet been accepted."}],"links":[{"id":"io.github.theboyyss.deadair.dialogue.mara.greeting.link.broadcast","linkType":"linkTo","targetTopicId":"io.github.theboyyss.deadair.topic.mara.broadcast","summary":"Open questions about the broadcast."},{"id":"io.github.theboyyss.deadair.dialogue.mara.greeting.link.agreement","linkType":"linkTo","targetTopicId":"io.github.theboyyss.deadair.topic.mara.agreement","summary":"Allow the Courier to accept the investigation."},{"id":"io.github.theboyyss.deadair.dialogue.mara.greeting.link.refusal","linkType":"linkTo","targetTopicId":"io.github.theboyyss.deadair.topic.mara.refusal","summary":"Allow a temporary refusal."}],"responseRoutes":[{"id":"io.github.theboyyss.deadair.dialogue.mara.greeting.route.broadcast","routeKey":"ask-broadcast","targetTopicId":"io.github.theboyyss.deadair.topic.mara.broadcast","summary":"Route to broadcast questions."},{"id":"io.github.theboyyss.deadair.dialogue.mara.greeting.route.accept","routeKey":"accept","targetTopicId":"io.github.theboyyss.deadair.topic.mara.agreement","summary":"Route to investigation acceptance."},{"id":"io.github.theboyyss.deadair.dialogue.mara.greeting.route.refuse","routeKey":"refuse","targetTopicId":"io.github.theboyyss.deadair.topic.mara.refusal","summary":"Route to temporary refusal."}],"tags":["mara","opening","lone-wolf-radio"]},{"id":"io.github.theboyyss.deadair.dialogue.mara.broadcast.names","questId":"io.github.theboyyss.deadair.quest.deadair","topicId":"io.github.theboyyss.deadair.topic.mara.broadcast","speaker":"DANPCMaraVoss","promptText":"What exactly did the broadcast say?","priority":50,"responseText":"Three names, a time, and a place. Then yours. Same format the NCR used for casualty traffic, except this signal is older than the Republic.","conditions":[{"id":"io.github.theboyyss.deadair.dialogue.mara.broadcast.names.condition.receiver","conditionType":"questStageDone","stageId":"io.github.theboyyss.deadair.quest.deadair.stage.lonewolfradio","summary":"The emergency receiver has been inspected."},{"id":"io.github.theboyyss.deadair.dialogue.mara.broadcast.names.condition.openingzero","conditionType":"questVariableEquals","variableId":"io.github.theboyyss.deadair.quest.deadair.variable.openingphase","equalsInteger":0,"summary":"The opening investigation has not yet been accepted."}],"links":[{"id":"io.github.theboyyss.deadair.dialogue.mara.broadcast.names.link.agreement","linkType":"linkTo","targetTopicId":"io.github.theboyyss.deadair.topic.mara.agreement","summary":"Return to the investigation offer."},{"id":"io.github.theboyyss.deadair.dialogue.mara.broadcast.names.link.refusal","linkType":"linkTo","targetTopicId":"io.github.theboyyss.deadair.topic.mara.refusal","summary":"Allow a temporary refusal."}],"tags":["mara","exposition"]},{"id":"io.github.theboyyss.deadair.dialogue.mara.broadcast.station","questId":"io.github.theboyyss.deadair.quest.deadair","topicId":"io.github.theboyyss.deadair.topic.mara.broadcast","speaker":"DANPCMaraVoss","promptText":"Is this trailer transmitting it?","priority":50,"responseText":"No. Lone Wolf is only catching the spill. Somebody woke up a stronger relay and aimed it through every dead repeater in the valley.","conditions":[{"id":"io.github.theboyyss.deadair.dialogue.mara.broadcast.station.condition.receiver","conditionType":"questStageDone","stageId":"io.github.theboyyss.deadair.quest.deadair.stage.lonewolfradio","summary":"The emergency receiver has been inspected."},{"id":"io.github.theboyyss.deadair.dialogue.mara.broadcast.station.condition.openingzero","conditionType":"questVariableEquals","variableId":"io.github.theboyyss.deadair.quest.deadair.variable.openingphase","equalsInteger":0,"summary":"The opening investigation has not yet been accepted."}],"links":[{"id":"io.github.theboyyss.deadair.dialogue.mara.broadcast.station.link.agreement","linkType":"linkTo","targetTopicId":"io.github.theboyyss.deadair.topic.mara.agreement","summary":"Return to the investigation offer."},{"id":"io.github.theboyyss.deadair.dialogue.mara.broadcast.station.link.refusal","linkType":"linkTo","targetTopicId":"io.github.theboyyss.deadair.topic.mara.refusal","summary":"Allow a temporary refusal."}],"tags":["mara","location"]},{"id":"io.github.theboyyss.deadair.dialogue.mara.broadcast.science","questId":"io.github.theboyyss.deadair.quest.deadair","topicId":"io.github.theboyyss.deadair.topic.mara.broadcast","speaker":"DANPCMaraVoss","promptText":"[Science 45] A prediction needs data. What is it listening to?","priority":50,"skillGates":[{"id":"io.github.theboyyss.deadair.dialogue.mara.broadcast.science.gate","skill":"science","threshold":45,"summary":"Recognize that the system needs a surveillance data source."}],"responseText":"Exactly. Caravan schedules, medical calls, troop chatter, water reports—enough scraps and you can make tomorrow look like prophecy.","conditions":[{"id":"io.github.theboyyss.deadair.dialogue.mara.broadcast.science.condition.receiver","conditionType":"questStageDone","stageId":"io.github.theboyyss.deadair.quest.deadair.stage.lonewolfradio","summary":"The emergency receiver has been inspected."},{"id":"io.github.theboyyss.deadair.dialogue.mara.broadcast.science.condition.openingzero","conditionType":"questVariableEquals","variableId":"io.github.theboyyss.deadair.quest.deadair.variable.openingphase","equalsInteger":0,"summary":"The opening investigation has not yet been accepted."}],"links":[{"id":"io.github.theboyyss.deadair.dialogue.mara.broadcast.science.link.agreement","linkType":"linkTo","targetTopicId":"io.github.theboyyss.deadair.topic.mara.agreement","summary":"Return to the investigation offer."}],"tags":["mara","science","evidence"]},{"id":"io.github.theboyyss.deadair.dialogue.mara.agreement.accept","questId":"io.github.theboyyss.deadair.quest.deadair","topicId":"io.github.theboyyss.deadair.topic.mara.agreement","speaker":"DANPCMaraVoss","promptText":"I'll help you trace it.","priority":50,"responseText":"Then we start with the first name. If the broadcast is engineering these deaths, there'll be fingerprints before there are bodies.","conditions":[{"id":"io.github.theboyyss.deadair.dialogue.mara.agreement.accept.condition.receiver","conditionType":"questStageDone","stageId":"io.github.theboyyss.deadair.quest.deadair.stage.lonewolfradio","summary":"The emergency receiver has been inspected."},{"id":"io.github.theboyyss.deadair.dialogue.mara.agreement.accept.condition.openingzero","conditionType":"questVariableEquals","variableId":"io.github.theboyyss.deadair.quest.deadair.variable.openingphase","equalsInteger":0,"summary":"The opening investigation has not yet been accepted."}],"resultScripts":[{"id":"io.github.theboyyss.deadair.dialogue.mara.agreement.accept.result","scriptType":"dialogueResult","mutations":[{"id":"io.github.theboyyss.deadair.dialogue.mara.agreement.accept.mutation.openingphase","mutationType":"questVariableIncrement","variableId":"io.github.theboyyss.deadair.quest.deadair.variable.openingphase","deltaInteger":1,"summary":"Close the opening offer so acceptance cannot repeat."},{"id":"io.github.theboyyss.deadair.dialogue.mara.agreement.accept.mutation.maratrust","mutationType":"questVariableIncrement","variableId":"io.github.theboyyss.deadair.quest.deadair.variable.maratrust","deltaInteger":1,"summary":"Record Mara's initial trust after the Courier agrees to help."}],"summary":"Apply the declared opening-phase and trust mutations, then advance DAQDeadAir to stage 30 in GECK."}],"links":[{"id":"io.github.theboyyss.deadair.dialogue.mara.agreement.accept.link.firstvictim","linkType":"linkTo","targetTopicId":"io.github.theboyyss.deadair.topic.mara.firstvictim","summary":"Continue directly to the first victim briefing."}],"responseRoutes":[{"id":"io.github.theboyyss.deadair.dialogue.mara.agreement.accept.route.firstvictim","routeKey":"accepted","targetTopicId":"io.github.theboyyss.deadair.topic.mara.firstvictim","summary":"Route acceptance to Corporal Eli Venn's briefing."}],"tags":["mara","accept","stage-30"]},{"id":"io.github.theboyyss.deadair.dialogue.mara.refusal.later","questId":"io.github.theboyyss.deadair.quest.deadair","topicId":"io.github.theboyyss.deadair.topic.mara.refusal","speaker":"DANPCMaraVoss","promptText":"This sounds like someone else's problem.","priority":50,"responseText":"It became yours when the voice said your name. I'll be here when that sinks in.","conditions":[{"id":"io.github.theboyyss.deadair.dialogue.mara.refusal.later.condition.receiver","conditionType":"questStageDone","stageId":"io.github.theboyyss.deadair.quest.deadair.stage.lonewolfradio","summary":"The emergency receiver has been inspected."},{"id":"io.github.theboyyss.deadair.dialogue.mara.refusal.later.condition.openingzero","conditionType":"questVariableEquals","variableId":"io.github.theboyyss.deadair.quest.deadair.variable.openingphase","equalsInteger":0,"summary":"The opening investigation has not yet been accepted."}],"links":[{"id":"io.github.theboyyss.deadair.dialogue.mara.refusal.later.link.greeting","linkType":"linkTo","targetTopicId":"io.github.theboyyss.deadair.topic.mara.greeting","summary":"Keep Mara's offer available on the next conversation."}],"tags":["mara","refusal","reopenable"]},{"id":"io.github.theboyyss.deadair.dialogue.mara.firstvictim.briefing","questId":"io.github.theboyyss.deadair.quest.deadair","topicId":"io.github.theboyyss.deadair.topic.mara.firstvictim","speaker":"DANPCMaraVoss","promptText":"Who was the first name?","priority":50,"responseText":"Corporal Eli Venn. NCR signal corps. He's due at a field repeater on the old highway before sundown. The broadcast gave eighteen-forty and the words 'line failure.'","conditions":[{"id":"io.github.theboyyss.deadair.dialogue.mara.firstvictim.briefing.condition.acceptedstage","conditionType":"questStageDone","stageId":"io.github.theboyyss.deadair.quest.deadair.stage.meetmara","summary":"The Courier has accepted Mara's investigation."},{"id":"io.github.theboyyss.deadair.dialogue.mara.firstvictim.briefing.condition.openingone","conditionType":"questVariableEquals","variableId":"io.github.theboyyss.deadair.quest.deadair.variable.openingphase","equalsInteger":1,"summary":"The opening handoff has completed exactly once."}],"links":[{"id":"io.github.theboyyss.deadair.dialogue.mara.firstvictim.briefing.link.fromagreement","linkType":"linkFrom","sourceTopicId":"io.github.theboyyss.deadair.topic.mara.agreement","summary":"The briefing follows acceptance."}],"tags":["mara","first-victim","eli-venn","objective-30"]},{"id":"io.github.theboyyss.deadair.dialogue.mara.firstvictim.warning","questId":"io.github.theboyyss.deadair.quest.deadair","topicId":"io.github.theboyyss.deadair.topic.mara.firstvictim","speaker":"DANPCMaraVoss","promptText":"What does 'line failure' mean?","priority":50,"responseText":"Could mean his radio, a power cable, or his pulse. That's the trick—make the words vague enough and panic finishes the sentence.","conditions":[{"id":"io.github.theboyyss.deadair.dialogue.mara.firstvictim.warning.condition.acceptedstage","conditionType":"questStageDone","stageId":"io.github.theboyyss.deadair.quest.deadair.stage.meetmara","summary":"The Courier has accepted Mara's investigation."},{"id":"io.github.theboyyss.deadair.dialogue.mara.firstvictim.warning.condition.openingone","conditionType":"questVariableEquals","variableId":"io.github.theboyyss.deadair.quest.deadair.variable.openingphase","equalsInteger":1,"summary":"The opening handoff has completed exactly once."}],"tags":["mara","first-victim","foreshadowing"]}]}
