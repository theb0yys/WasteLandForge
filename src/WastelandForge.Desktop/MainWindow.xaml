<Window x:Class="WastelandForge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WastelandForge"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        Background="{StaticResource AppBackground}"
        Loaded="OnLoaded"
        Activated="WindowActivated">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="278" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="#12151A"
            BorderBrush="#303741"
            BorderThickness="0,0,1,0">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
          <Grid Width="72" Height="72" HorizontalAlignment="Left">
            <Ellipse Fill="#1D232A" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
            <TextBlock Text="WF"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Image x:Name="HeatAccentImage"
                   Stretch="Uniform"
                   Opacity="0.42"
                   Visibility="Collapsed" />
          </Grid>

          <TextBlock Text="WastelandForge"
                     Foreground="{StaticResource TextPrimary}"
                     FontSize="28"
                     FontWeight="Bold"
                     Margin="0,18,0,0" />
          <TextBlock Text="Premium Windows shell over the deterministic Forge backend."
                     Foreground="{StaticResource TextMuted}"
                     Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,34,0,0">
          <TextBlock Text="Shell"
                     Foreground="{StaticResource TextMuted}"
                     FontSize="12"
                     FontWeight="Bold" />
          <TextBlock x:Name="BackendStatusTextBlock"
                     Text="Backend not checked"
                     Foreground="{StaticResource TextPrimary}"
                     Margin="0,8,0,0" />
          <TextBlock x:Name="HeatStatusTextBlock"
                     Text="Heat UI skin not checked"
                     Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,36,0,0">
          <Button x:Name="RefreshButton"
                  Content="Refresh Backend"
                  Click="RefreshBackendClicked" />
          <Button Content="Open Publish Folder"
                  Margin="0,10,0,0"
                  Click="OpenPublishFolderClicked" />
          <Button Content="Open App Log"
                  Margin="0,10,0,0"
                  Click="OpenAppLogClicked" />
        </StackPanel>

        <StackPanel Grid.Row="3">
          <TextBlock Text="forge.exe"
                     Foreground="{StaticResource TextMuted}"
                     FontSize="12"
                     FontWeight="Bold" />
          <TextBlock x:Name="ForgePathTextBlock"
                     Text="Resolving..."
                     Margin="0,8,0,0"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="30,28,30,28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock Text="Project command center"
                     Foreground="{StaticResource TextPrimary}"
                     FontSize="30"
                     FontWeight="Bold" />
          <TextBlock Text="Build and verify a basic MCM package without exposing a console window."
                     Foreground="{StaticResource TextMuted}"
                     Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Column="1"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderMuted}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="Backend version"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12"
                       FontWeight="Bold" />
            <TextBlock x:Name="VersionTextBlock"
                       Text="Pending"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15"
                       Margin="0,5,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="1"
              Margin="0,24,0,20"
              Background="{StaticResource PanelBackground}"
              BorderBrush="{StaticResource BorderMuted}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Project root"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12"
                       FontWeight="Bold" />
            <TextBox x:Name="ProjectPathTextBox"
                     Margin="0,8,0,0"
                     MinWidth="420"
                     TextChanged="ProjectPathChanged" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="Browse"
                  Margin="14,21,0,0"
                  VerticalAlignment="Top"
                  Click="BrowseProjectClicked" />
          <Button x:Name="ValidateButton"
                  Grid.Column="2"
                  Content="Validate"
                  Style="{StaticResource PrimaryButton}"
                  Margin="10,21,0,0"
                  VerticalAlignment="Top"
                  Click="ValidateProjectClicked" />
        </Grid>
      </Border>

      <TabControl x:Name="MainTabControl" Grid.Row="2" SelectedIndex="1">
        <TabItem Header="Dashboard">
          <Grid Margin="0,18,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="2*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,14,0">
              <StackPanel>
                <TextBlock Text="Backend"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="Bold" />
                <TextBlock x:Name="BackendDetailTextBlock"
                           Text="Waiting for forge.exe --version"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0" />
                <TextBlock Text="The app shell talks to the bundled Forge executable instead of duplicating validation logic."
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,12,0,0" />
              </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,14,0">
              <StackPanel>
                <TextBlock Text="Capabilities"
                           Foreground="{StaticResource InfoBrush}"
                           FontWeight="Bold" />
                <TextBlock x:Name="CapabilityStatusTextBlock"
                           Text="Waiting for capabilities list"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0" />
                <TextBlock x:Name="CapabilitySummaryTextBlock"
                           Text="No catalogue response yet."
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,12,0,0" />
                <Button x:Name="DashboardDoctorScanButton"
                        Content="Scan Environment"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Left"
                        Click="ScanEnvironmentClicked" />
              </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
              <StackPanel>
                <TextBlock Text="Validation"
                           Foreground="{StaticResource OkBrush}"
                           FontWeight="Bold" />
                <TextBlock x:Name="ValidationStatusTextBlock"
                           Text="Not run"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0" />
                <TextBlock x:Name="ValidationSummaryTextBlock"
                           Text="Select a project and run validation."
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,12,0,0" />
              </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,18,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.15*" />
                  <ColumnDefinition Width="1.85*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <TextBlock Text="MCM package"
                             Foreground="{StaticResource AccentBrush}"
                             FontWeight="Bold" />
                  <TextBlock x:Name="BuilderStatusTextBlock"
                             Text="Ready"
                             Foreground="{StaticResource TextPrimary}"
                             FontSize="20"
                             FontWeight="SemiBold"
                             Margin="0,10,0,0" />
                  <TextBlock x:Name="BuilderSummaryTextBlock"
                             Text="Run the full build to create and verify dist/mcm-json/package.zip."
                             Foreground="{StaticResource TextMuted}"
                             Margin="0,12,0,0" />
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                  <Button x:Name="BuildBasicModButton"
                          Content="Build Basic Mod"
                          Style="{StaticResource PrimaryButton}"
                          Margin="0,0,10,10"
                          Click="BuildBasicModClicked" />
                  <Button x:Name="GenerateMcmButton"
                          Content="Generate MCM"
                          Margin="0,0,10,10"
                          Click="GenerateMcmClicked" />
                  <Button x:Name="PackageMcmButton"
                          Content="Package ZIP"
                          Margin="0,0,10,10"
                          Click="PackageMcmClicked" />
                  <Button x:Name="VerifyPackageButton"
                          Content="Verify Package"
                          Margin="0,0,10,10"
                          Click="VerifyPackageClicked" />
                  <Button x:Name="OpenPackageButton"
                          Content="Open Package"
                          Margin="0,0,0,10"
                          Click="OpenPackageClicked" />
                </WrapPanel>
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <TabItem x:Name="ModBuilderTabItem" Header="Mod Builder">
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="360" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,18,0">
              <StackPanel>
                <TextBlock Text="Workflow"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="Bold" />
                <Button x:Name="ModBuilderBuildButton"
                        Content="Build Basic Mod"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,16,0,0"
                        Click="BuildBasicModClicked" />
                <Button x:Name="ModBuilderDemoButton"
                        Content="Reset Demo Project"
                        Margin="0,10,0,0"
                        Click="ResetDemoProjectClicked" />
                <Button x:Name="ModBuilderValidateButton"
                        Content="Validate"
                        Margin="0,10,0,0"
                        Click="ValidateProjectClicked" />
                <Button x:Name="PostCreateCapabilityScanButton"
                        Content="Scan Project Capabilities"
                        Margin="0,10,0,0"
                        IsEnabled="False"
                        Click="PostCreateCapabilityScanClicked" />
                <Button x:Name="PostCreateDocsButton"
                        Content="Generate Project Docs"
                        Margin="0,10,0,0"
                        IsEnabled="False"
                        Click="PostCreateDocsClicked" />
                <Button x:Name="OpenDocsFolderButton"
                        Content="Open Docs Folder"
                        Margin="0,10,0,0"
                        IsEnabled="False"
                        Click="OpenDocsFolderClicked" />
                <Button x:Name="ModBuilderGenerateButton"
                        Content="Generate MCM"
                        Margin="0,10,0,0"
                        Click="GenerateMcmClicked" />
                <Button x:Name="ModBuilderPackageButton"
                        Content="Package ZIP"
                        Margin="0,10,0,0"
                        Click="PackageMcmClicked" />
                <Button x:Name="ModBuilderVerifyButton"
                        Content="Verify Package"
                        Margin="0,10,0,0"
                        Click="VerifyPackageClicked" />
                <Button x:Name="ModBuilderOpenPackageButton"
                        Content="Open Package Folder"
                        Margin="0,10,0,0"
                        Click="OpenPackageClicked" />

                <Separator Margin="0,22,0,18" />

                <TextBlock Text="Project docs"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           FontWeight="Bold" />
                <TextBlock x:Name="DocsStatusTextBlock"
                           Text="Not generated"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0" />
                <TextBlock x:Name="DocsPathTextBlock"
                           Text="generated/docs"
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />

                <Separator Margin="0,22,0,18" />

                <TextBlock Text="Package"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           FontWeight="Bold" />
                <TextBlock x:Name="PackageStatusTextBlock"
                           Text="Not built"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0" />
                <TextBlock x:Name="PackagePathTextBlock"
                           Text="dist/mcm-json/package.zip"
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="PackageEntriesTextBlock"
                           Text="No package entries loaded."
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,8,0,0" />
              </StackPanel>
            </Border>

            <TabControl Grid.Column="1">
              <TabItem Header="Command Output">
                <TextBox x:Name="BuilderOutputTextBox"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="13"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         TextWrapping="NoWrap" />
              </TabItem>
              <TabItem x:Name="DocsIndexTabItem" Header="Docs Index" IsEnabled="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="16">
                    <TextBlock x:Name="DocsIndexSummaryTextBlock"
                               Text="Generate project docs to load the reference index."
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,8" />
                    <TextBox x:Name="DocsIndexFilterTextBox"
                             Margin="0,0,0,14"
                             ToolTip="Filter reference title, ID, kind, source, version, or description"
                             TextChanged="DocsIndexFilterChanged" />
                    <Border Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderMuted}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,18">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="220" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock x:Name="SelectedDocsReferenceTitleTextBlock" Text="No reference selected" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                          <TextBlock x:Name="SelectedDocsReferenceIdTextBlock" Text="Select an entry below." Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                          <TextBlock x:Name="SelectedDocsReferenceSourceTextBlock" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                          <TextBlock x:Name="SelectedDocsReferencePathTextBlock" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="OpenDocsReferenceButton"
                                Grid.Column="1"
                                Content="Open Reference"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                Click="OpenDocsReferenceClicked" />
                        <TextBox x:Name="MarkdownPreviewTextBox"
                                 Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 Margin="0,14,0,0"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 Text="Select a reference to preview its generated Markdown."
                                 TextWrapping="NoWrap" />
                      </Grid>
                    </Border>
                    <ItemsControl x:Name="DocsIndexSectionsItemsControl">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding Entries}"
                                     Margin="0,8,0,0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionChanged="DocsReferenceSelectionChanged">
                              <ListBox.ItemTemplate>
                                <DataTemplate>
                                  <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="220" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                      <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                      <TextBlock Text="{Binding Kind}" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                      <TextBlock Text="{Binding Id}" Foreground="{StaticResource TextPrimary}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                                      <TextBlock Text="{Binding Source}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                                      <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                  </Grid>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Grid>
        </TabItem>

        <TabItem x:Name="ValidationReportTabItem" Header="Validation Report">
          <Grid Margin="0,18,0,0">
            <TextBox x:Name="ValidationOutputTextBox"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="13"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     TextWrapping="NoWrap" />
          </Grid>
        </TabItem>

        <TabItem x:Name="CapabilitiesTabItem" Header="Capabilities">
          <Grid Margin="0,18,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Doctor readiness" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="DoctorSummaryTextBlock"
                           Text="Save local setup paths, then scan the environment."
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,5,0,0" />
              </StackPanel>
              <Button x:Name="CapabilitiesDoctorScanButton"
                      Grid.Column="1"
                      Content="Scan Environment"
                      Style="{StaticResource PrimaryButton}"
                      Click="ScanEnvironmentClicked" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
              <ItemsControl x:Name="DoctorAreasItemsControl">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderMuted}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="220" />
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="16" />
                          <TextBlock Text="{Binding Coverage}" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4" Padding="9,4" Background="{StaticResource PanelRaised}">
                          <TextBlock x:Name="StatusText" Text="{Binding Status}" FontWeight="SemiBold" />
                        </Border>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Actions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding}" Margin="0,0,0,5" Foreground="{StaticResource TextSecondary}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Grid.Column="3"
                                Content="View Evidence"
                                Tag="{Binding Id}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Top"
                                Click="ViewDoctorEvidenceClicked" />
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Status}" Value="ready">
                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource OkBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="action-needed">
                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="unknown">
                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource TextMuted}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border x:Name="ProviderEvidencePanel"
                      Visibility="Collapsed"
                      Background="{StaticResource PanelRaised}"
                      BorderBrush="{StaticResource BorderMuted}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="18"
                      Margin="0,6,0,10">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProviderEvidenceTitleTextBlock"
                               Text="Provider evidence"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <Button Grid.Column="1"
                            Content="Configure Paths"
                            Click="ConfigurePathsClicked" />
                  </Grid>
                  <TextBlock Text="Physical path evidence reported by forge.exe. No tools are executed."
                             Foreground="{StaticResource TextMuted}"
                             Margin="0,5,0,14" />
                  <ItemsControl x:Name="ProviderEvidenceItemsControl">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderMuted}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14"
                                Margin="0,0,0,10">
                          <StackPanel>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                              <Button Grid.Column="1"
                                      Content="Explain"
                                      Tag="{Binding Id}"
                                      Padding="12,5"
                                      Click="ExplainProviderClicked" />
                            </Grid>
                            <TextBlock Margin="0,4,0,8">
                              <Run Text="{Binding Status}" />
                              <Run Text="  |  " />
                              <Run Text="{Binding InstallScope}" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Evidence}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <StackPanel Margin="0,4,0,5">
                                    <TextBlock Foreground="{StaticResource TextMuted}">
                                      <Run Text="{Binding Status}" />
                                      <Run Text="  |  " />
                                      <Run Text="{Binding DetectorKind}" />
                                      <Run Text="  |  " />
                                      <Run Text="{Binding Scope}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Path}" FontFamily="Cascadia Mono, Consolas" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Message}" Margin="0,2,0,0" />
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border x:Name="ProviderExplanationPanel"
                          Visibility="Collapsed"
                          Background="{StaticResource PanelBackground}"
                          BorderBrush="{StaticResource BorderMuted}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="14">
                    <StackPanel>
                      <TextBlock x:Name="ProviderExplanationTitleTextBlock"
                                 Text="Provider explanation"
                                 Foreground="{StaticResource TextPrimary}"
                                 FontWeight="SemiBold" />
                      <TextBlock x:Name="ProviderExplanationStatusTextBlock"
                                 Text="Waiting"
                                 Foreground="{StaticResource TextMuted}"
                                 Margin="0,4,0,8" />
                      <TextBlock x:Name="ProviderExplanationDescriptionTextBlock"
                                 Foreground="{StaticResource TextSecondary}"
                                 Margin="0,0,0,10" />
                      <TextBlock Text="Next actions" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                      <ItemsControl x:Name="ProviderExplanationActionsItemsControl" Margin="0,5,0,10">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,0,0,4" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="Related capabilities" Foreground="{StaticResource InfoBrush}" FontWeight="SemiBold" />
                      <ItemsControl x:Name="ProviderExplanationCapabilitiesItemsControl" Margin="0,5,0,10">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{StaticResource PanelRaised}" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                              <TextBlock Text="{Binding}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="Evidence groups" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                      <ItemsControl x:Name="ProviderExplanationGroupsItemsControl" Margin="0,5,0,8">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                              <TextBlock>
                                <Run Text="{Binding Title}" FontWeight="SemiBold" />
                                <Run Text="  |  " />
                                <Run Text="{Binding Status}" />
                                <Run Text="  |  " />
                                <Run Text="{Binding InstallScope}" />
                              </TextBlock>
                              <ItemsControl ItemsSource="{Binding Evidence}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <StackPanel Margin="0,4,0,4">
                                      <TextBlock Foreground="{StaticResource TextMuted}">
                                        <Run Text="{Binding Status}" />
                                        <Run Text="  |  " />
                                        <Run Text="{Binding DetectorKind}" />
                                        <Run Text="  |  " />
                                        <Run Text="{Binding Scope}" />
                                      </TextBlock>
                                      <TextBlock Text="{Binding Path}" FontFamily="Cascadia Mono, Consolas" />
                                      <TextBlock Text="{Binding Message}" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Expander Header="Advanced Explanation JSON">
                        <TextBox x:Name="ProviderExplanationTextBox"
                                 Height="220"
                                 Margin="0,8,0,0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="Cascadia Mono, Consolas"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" />
                      </Expander>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
              </StackPanel>
            </ScrollViewer>
            <Expander Grid.Row="2" Header="Advanced JSON" Margin="0,8,0,0">
              <TextBox x:Name="CapabilityJsonTextBox"
                       Height="240"
                       Margin="0,8,0,0"
                       AcceptsReturn="True"
                       AcceptsTab="True"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="13"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       IsReadOnly="True"
                       TextWrapping="NoWrap" />
            </Expander>
          </Grid>
        </TabItem>

        <TabItem x:Name="SettingsTabItem" Header="Settings">
          <ScrollViewer Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="920" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
                <TextBlock Text="Local setup" Foreground="{StaticResource TextPrimary}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Machine-specific paths are stored locally and are not written into the Forge project."
                           Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" />
              </StackPanel>

              <Border Grid.Row="1" Grid.ColumnSpan="3"
                      Background="{StaticResource PanelRaised}"
                      BorderBrush="{StaticResource BorderMuted}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="16"
                      Margin="0,0,0,14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Setup readiness" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="17" />
                    <TextBlock x:Name="SetupReadinessTextBlock"
                               Text="Checking local path configuration..."
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,5,0,0" />
                  </StackPanel>
                  <Button x:Name="SaveAndScanButton"
                          Grid.Column="1"
                          Content="Save &amp; Scan"
                          Style="{StaticResource PrimaryButton}"
                          Click="SaveAndScanClicked" />
                </Grid>
              </Border>

              <TextBlock Grid.Row="2" Text="Project root" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="SettingsProjectRootTextBox" Grid.Row="2" Grid.Column="1" Margin="12,5" TextChanged="SettingsPathChanged" />
              <Button Grid.Row="2" Grid.Column="2" Content="Browse" Margin="8,5,0,5" Tag="project" Click="BrowseSettingsFolderClicked" />

              <TextBlock Grid.Row="3" Text="Fallout: New Vegas root" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="GameRootTextBox" Grid.Row="3" Grid.Column="1" Margin="12,5" TextChanged="SettingsPathChanged" />
              <Button Grid.Row="3" Grid.Column="2" Content="Browse" Margin="8,5,0,5" Tag="game" Click="BrowseSettingsFolderClicked" />

              <TextBlock Grid.Row="4" Text="Data root" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="DataRootTextBox" Grid.Row="4" Grid.Column="1" Margin="12,5" TextChanged="SettingsPathChanged" />
              <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Margin="8,5,0,5">
                <Button x:Name="UseGameDataButton"
                        Content="Use Game\Data"
                        Margin="0,0,8,0"
                        Click="UseGameDataClicked" />
                <Button Content="Browse" Tag="data" Click="BrowseSettingsFolderClicked" />
              </StackPanel>

              <TextBlock Grid.Row="5" Text="Mod Organizer 2" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="Mo2PathTextBox" Grid.Row="5" Grid.Column="1" Margin="12,5" TextChanged="SettingsPathChanged" />
              <Button Grid.Row="5" Grid.Column="2" Content="Browse" Margin="8,5,0,5" Tag="mo2" Click="BrowseSettingsFileClicked" />

              <TextBlock Grid.Row="6" Text="MO2 mods folder" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="SettingsMo2ModsRootTextBox" Grid.Row="6" Grid.Column="1" Margin="12,5" TextChanged="SettingsPathChanged" />
              <Button Grid.Row="6" Grid.Column="2" Content="Browse" Margin="8,5,0,5" Tag="mo2mods" Click="BrowseSettingsFolderClicked" />

              <TextBlock Grid.Row="7" Text="GECK" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="GeckPathTextBox" Grid.Row="7" Grid.Column="1" Margin="12,5" TextChanged="SettingsPathChanged" />
              <Button Grid.Row="7" Grid.Column="2" Content="Browse" Margin="8,5,0,5" Tag="geck" Click="BrowseSettingsFileClicked" />

              <TextBlock Grid.Row="8" Text="xEdit" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="XEditPathTextBox" Grid.Row="8" Grid.Column="1" Margin="12,5" TextChanged="SettingsPathChanged" />
              <Button Grid.Row="8" Grid.Column="2" Content="Browse" Margin="8,5,0,5" Tag="xedit" Click="BrowseSettingsFileClicked" />

              <Grid Grid.Row="9" Grid.ColumnSpan="3" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SettingsStatusTextBlock" Text="Settings have not been changed." Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Reset" Margin="0,0,10,0" Click="ResetSettingsClicked" />
                <Button x:Name="SaveSettingsButton" Grid.Column="2" Content="Save Settings" Style="{StaticResource PrimaryButton}" Click="SaveSettingsClicked" />
              </Grid>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="New Project">
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="360" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,18,0">
              <StackPanel>
                <TextBlock Text="New Forge project" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="SemiBold" />

                <TextBlock Text="Project name" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" Margin="0,18,0,0" />
                <TextBox x:Name="NewProjectNameTextBox" Margin="0,7,0,0" TextChanged="NewProjectInputChanged" />

                <TextBlock Text="Target project folder" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" Margin="0,14,0,0" />
                <TextBox x:Name="NewProjectPathTextBox" Margin="0,7,0,0" TextChanged="NewProjectInputChanged" />
                <Button Content="Choose Parent Folder" Margin="0,8,0,0" Click="BrowseNewProjectParentClicked" />

                <TextBlock Text="Template" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" Margin="0,14,0,0" />
                <ComboBox x:Name="NewProjectTemplateComboBox"
                          Margin="0,7,0,0"
                          Padding="8"
                          SelectedIndex="0"
                          SelectionChanged="NewProjectInputChanged">
                  <ComboBoxItem Content="FNV Basic" Tag="fnv-basic" />
                  <ComboBoxItem Content="FNV Framework" Tag="fnv-framework" />
                  <ComboBoxItem Content="FNV Quest Pack" Tag="fnv-quest-pack" />
                  <ComboBoxItem Content="FNV Docs Only" Tag="fnv-docs-only" />
                </ComboBox>
                <TextBlock Text="FNV Framework creates runtime-enabled MCM and JIP source ready for combined packaging. The other templates retain the validated baseline scaffold."
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />

                <Button x:Name="PreviewNewProjectButton"
                        Content="Preview"
                        Margin="0,20,0,0"
                        Click="PreviewNewProjectClicked" />
                <Button x:Name="CreateProjectButton"
                        Content="Create Project"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,10,0,0"
                        IsEnabled="False"
                        Click="CreateNewProjectClicked" />
                <TextBlock x:Name="NewProjectStatusTextBlock"
                           Text="Preview the current inputs before creating files."
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <TextBox x:Name="NewProjectOutputTextBox"
                     Grid.Column="1"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="13"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     TextWrapping="NoWrap" />
          </Grid>
        </TabItem>

        <TabItem Header="Narrative Author">
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="420" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,18,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Narrative Author" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="SemiBold" />
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="NarrativeInventoryStateTextBlock" Text="Inventory: Not loaded" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock x:Name="NarrativeInventorySummaryTextBlock" Text="Select a project and refresh inventory." Foreground="{StaticResource TextMuted}" Margin="0,3,8,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button x:Name="RefreshNarrativeInventoryButton" Grid.Column="1" Content="Refresh inventory" Click="RefreshNarrativeInventoryClicked" VerticalAlignment="Top" />
                </Grid>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock x:Name="NarrativeJournalStatusTextBlock" Text="Last change: none" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Button x:Name="ReviewNarrativeUndoButton" Grid.Column="1" Content="Review undo" Margin="8,0,0,0" Click="ReviewNarrativeUndoClicked" />
                  <Button x:Name="ApplyNarrativeUndoButton" Grid.Column="2" Content="Undo last change" Margin="8,0,0,0" IsEnabled="False" Click="ApplyNarrativeUndoClicked" />
                </Grid>
                <Expander x:Name="NarrativeExplorerExpander" Header="Project explorer" Margin="0,8,0,0" IsExpanded="True" IsEnabled="False">
                  <StackPanel Margin="0,6,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <ComboBox x:Name="NarrativeExplorerViewComboBox" SelectionChanged="NarrativeExplorerFilterChanged"><ComboBoxItem Content="Quests" IsSelected="True" /><ComboBoxItem Content="Dialogue" /></ComboBox>
                      <TextBox x:Name="NarrativeExplorerSearchTextBox" Grid.Column="1" Margin="8,0,0,0" TextChanged="NarrativeExplorerFilterChanged" />
                    </Grid>
                    <ListBox x:Name="NarrativeExplorerListBox" Height="150" Margin="0,6,0,0" DisplayMemberPath="Display" SelectionChanged="NarrativeExplorerSelectionChanged" />
                    <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <ComboBox x:Name="NarrativeExplorerRouteComboBox" MinWidth="220" />
                      <Button x:Name="OpenNarrativeExplorerRouteButton" Grid.Column="1" Content="Open in workflow" Margin="8,0,0,0" IsEnabled="False" Click="OpenNarrativeExplorerRouteClicked" />
                    </Grid>
                  </StackPanel>
                </Expander>
                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <ComboBox x:Name="NarrativeCategoryComboBox" SelectionChanged="NarrativeCategoryChanged"><ComboBoxItem Content="Source" IsSelected="True" /><ComboBoxItem Content="Quest" /><ComboBoxItem Content="Dialogue" /><ComboBoxItem Content="Voice &amp; GECK" /></ComboBox>
                  <ComboBox x:Name="NarrativeWorkflowComboBox" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="NarrativeWorkflowChanged" />
                </Grid>
                <TextBlock x:Name="NarrativeSelectedWorkflowTextBlock" Text="Create Narrative Source" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
                <TextBlock x:Name="NarrativeAuthorStatusTextBlock" Text="Preview before creating source." Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <ScrollViewer x:Name="NarrativeAuthorScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <StackPanel x:Name="DialogueBranchWorkflowPanel" Visibility="Collapsed">
                <TextBlock x:Name="DialogueBranchSection" Text="Add dialogue branch" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                <Button Content="Load Dialogue Branch Choices" Margin="0,10,0,0" HorizontalAlignment="Left" Click="LoadDialogueBranchClicked" />
                <TextBlock Text="Dialogue line" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><ComboBox x:Name="DialogueBranchLineComboBox" DisplayMemberPath="Display" SelectionChanged="DialogueBranchInputChanged" />
                <TextBlock Text="Branch kind" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><ComboBox x:Name="DialogueBranchModeComboBox" SelectionChanged="DialogueBranchInputChanged"><ComboBoxItem Content="Link To" IsSelected="True" /><ComboBoxItem Content="Link From" /><ComboBoxItem Content="Response Route" /></ComboBox>
                <TextBlock Text="Referenced topic" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><ComboBox x:Name="DialogueBranchTopicComboBox" DisplayMemberPath="Display" SelectionChanged="DialogueBranchInputChanged" />
                <TextBlock Text="Branch slug / summary" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><TextBox x:Name="DialogueBranchSlugTextBox" Text="nexttopic" TextChanged="DialogueBranchInputChanged" /><TextBox x:Name="DialogueBranchSummaryTextBox" Margin="0,4,0,0" TextChanged="DialogueBranchInputChanged" />
                <TextBlock Text="Response route key" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><TextBox x:Name="DialogueBranchRouteKeyTextBox" Text="authored-route" TextChanged="DialogueBranchInputChanged" />
                <WrapPanel Margin="0,14,0,18"><Button Content="Preview Dialogue Branch" Click="PreviewDialogueBranchClicked" /><Button x:Name="AppendDialogueBranchButton" Content="Append, Validate and Rebuild Handoff" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="AppendDialogueBranchClicked" /></WrapPanel>
                <Separator Margin="0,2,0,14" />
                </StackPanel>
                <StackPanel x:Name="DialogueRevisionWorkflowPanel" Visibility="Collapsed">
                <TextBlock x:Name="DialogueRevisionSection" Text="Revise dialogue line" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                <Button Content="Load Dialogue Lines" Margin="0,10,0,0" HorizontalAlignment="Left" Click="LoadDialogueRevisionClicked" />
                <TextBlock Text="Dialogue line" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><ComboBox x:Name="DialogueRevisionLineComboBox" DisplayMemberPath="Display" SelectionChanged="DialogueRevisionLineChanged" />
                <TextBlock Text="Response text" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><TextBox x:Name="DialogueRevisionResponseTextBox" TextChanged="DialogueRevisionInputChanged" />
                <TextBlock Text="Speaker (optional)" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><TextBox x:Name="DialogueRevisionSpeakerTextBox" TextChanged="DialogueRevisionInputChanged" />
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Prompt (optional)" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="DialogueRevisionPromptTextBox" TextChanged="DialogueRevisionInputChanged" /></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Priority" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="DialogueRevisionPriorityTextBox" TextChanged="DialogueRevisionInputChanged" /></StackPanel></Grid>
                <WrapPanel Margin="0,14,0,18"><Button Content="Preview Dialogue Revision" Click="PreviewDialogueRevisionClicked" /><Button x:Name="ApplyDialogueRevisionButton" Content="Apply, Validate and Rebuild Handoff" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="ApplyDialogueRevisionClicked" /></WrapPanel>
                <Separator Margin="0,2,0,14" />
                </StackPanel>
                <StackPanel x:Name="QuestRevisionWorkflowPanel" Visibility="Collapsed">
                <TextBlock x:Name="QuestRevisionSection" Text="Revise quest presentation" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                <Button Content="Load Quest Presentation" Margin="0,10,0,0" HorizontalAlignment="Left" Click="LoadQuestRevisionClicked" />
                <TextBlock Text="Quest" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><ComboBox x:Name="QuestRevisionQuestComboBox" DisplayMemberPath="Display" SelectionChanged="QuestRevisionQuestChanged" />
                <TextBlock Text="Stage" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><ComboBox x:Name="QuestRevisionStageComboBox" DisplayMemberPath="Display" SelectionChanged="QuestRevisionSelectionChanged" />
                <TextBlock Text="Objective" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><ComboBox x:Name="QuestRevisionObjectiveComboBox" DisplayMemberPath="Display" SelectionChanged="QuestRevisionSelectionChanged" />
                <TextBlock Text="Quest title / summary" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><TextBox x:Name="QuestRevisionTitleTextBox" TextChanged="QuestRevisionInputChanged" /><TextBox x:Name="QuestRevisionSummaryTextBox" Margin="0,4,0,0" TextChanged="QuestRevisionInputChanged" />
                <TextBlock Text="Stage title / summary" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><TextBox x:Name="QuestRevisionStageTitleTextBox" TextChanged="QuestRevisionInputChanged" /><TextBox x:Name="QuestRevisionStageSummaryTextBox" Margin="0,4,0,0" TextChanged="QuestRevisionInputChanged" />
                <TextBlock Text="Objective text" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><TextBox x:Name="QuestRevisionObjectiveTextBox" TextChanged="QuestRevisionInputChanged" />
                <WrapPanel Margin="0,14,0,18"><Button Content="Preview Quest Revision" Click="PreviewQuestRevisionClicked" /><Button x:Name="ApplyQuestRevisionButton" Content="Apply, Validate and Rebuild Handoff" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="ApplyQuestRevisionClicked" /></WrapPanel>
                <Separator Margin="0,2,0,14" />
                </StackPanel>
                <StackPanel x:Name="QuestVariableWorkflowPanel" Visibility="Collapsed">
                <TextBlock x:Name="QuestVariableSection" Text="Add quest variable" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                <Button Content="Load Variable Quest Choices" Margin="0,10,0,0" HorizontalAlignment="Left" Click="LoadQuestVariableClicked" />
                <TextBlock Text="Quest" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><ComboBox x:Name="QuestVariableQuestComboBox" DisplayMemberPath="Display" SelectionChanged="QuestVariableInputChanged" />
                <TextBlock Text="Variable slug / initial value" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBox x:Name="QuestVariableSlugTextBox" Text="newstate" TextChanged="QuestVariableInputChanged" /><TextBox Grid.Column="1" x:Name="QuestVariableInitialValueTextBox" Text="0" Margin="8,0,0,0" TextChanged="QuestVariableInputChanged" /></Grid>
                <TextBlock Text="Title / summary (optional)" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><TextBox x:Name="QuestVariableTitleTextBox" TextChanged="QuestVariableInputChanged" /><TextBox x:Name="QuestVariableSummaryTextBox" Margin="0,4,0,0" TextChanged="QuestVariableInputChanged" />
                <WrapPanel Margin="0,14,0,18"><Button Content="Preview Quest Variable" Click="PreviewQuestVariableClicked" /><Button x:Name="AppendQuestVariableButton" Content="Append, Validate and Rebuild Handoff" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="AppendQuestVariableClicked" /></WrapPanel>
                <Separator Margin="0,2,0,14" />
                </StackPanel>
                <StackPanel x:Name="QuestConditionWorkflowPanel" Visibility="Collapsed">
                <TextBlock x:Name="QuestConditionSection" Text="Add quest condition" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                <Button Content="Load Quest Condition Choices" Margin="0,10,0,0" HorizontalAlignment="Left" Click="LoadQuestConditionClicked" />
                <TextBlock Text="Quest" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><ComboBox x:Name="QuestConditionQuestComboBox" DisplayMemberPath="Display" SelectionChanged="QuestConditionQuestChanged" />
                <TextBlock Text="Condition mode" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><ComboBox x:Name="QuestConditionModeComboBox" SelectionChanged="QuestConditionInputChanged"><ComboBoxItem Content="Stage Done" IsSelected="True" /><ComboBoxItem Content="Variable Equals" /></ComboBox>
                <TextBlock Text="Quest stage" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><ComboBox x:Name="QuestConditionStageComboBox" DisplayMemberPath="Display" SelectionChanged="QuestConditionInputChanged" />
                <TextBlock Text="Quest variable / equals integer" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><ComboBox x:Name="QuestConditionVariableComboBox" DisplayMemberPath="Display" SelectionChanged="QuestConditionInputChanged" /><TextBox Grid.Column="1" x:Name="QuestConditionEqualsTextBox" Text="0" Margin="8,0,0,0" TextChanged="QuestConditionInputChanged" /></Grid>
                <TextBlock Text="Condition slug / title / summary" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><TextBox x:Name="QuestConditionSlugTextBox" Text="newcondition" TextChanged="QuestConditionInputChanged" /><TextBox x:Name="QuestConditionTitleTextBox" Margin="0,4,0,0" TextChanged="QuestConditionInputChanged" /><TextBox x:Name="QuestConditionSummaryTextBox" Margin="0,4,0,0" TextChanged="QuestConditionInputChanged" />
                <WrapPanel Margin="0,14,0,18"><Button Content="Preview Quest Condition" Click="PreviewQuestConditionClicked" /><Button x:Name="AppendQuestConditionButton" Content="Append, Validate and Rebuild Handoff" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="AppendQuestConditionClicked" /></WrapPanel>
