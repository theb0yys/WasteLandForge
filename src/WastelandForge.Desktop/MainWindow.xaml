            <TextBox x:Name="JipAuthorOutputTextBox" Grid.Column="1" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsReadOnly="True" TextWrapping="NoWrap" />
