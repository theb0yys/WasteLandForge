{
  "schemaVersion": "0.1.0",
  "kind": "jip-script",
  "id": "io.github.theboyyss.invalidjipscriptbodyregistry.jip_scripts",
  "scripts": [
    {
      "id": "io.github.theboyyss.invalidjipscriptbodyregistry.jip_scripts.bootstrap",
      "summary": "Synthetic invalid JIP LN text-script body fixture.",
      "lifecyclePrefix": "gr_",
      "outputFile": "gr_invalid_body.txt",
      "requires": {
        "capabilities": [
          {
            "id": "runtime.scripting.jip_script_runner"
          }
        ]
      },
      "sizePolicy": {
        "maxBytes": 16384
      },
      "formIdResolution": {
        "strategy": "explicitReferences"
      },
      "body": {
        "lineMode": "opaqueText",
        "lines": [
          {}
        ]
      }
    }
  ]
}
