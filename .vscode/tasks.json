{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Forge: Restore Local Tool",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/eng/Restore-ForgeTool.ps1",
        "-RestoreRoot",
        "artifacts/local-tool/restore/dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Forge: Help",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "tool",
        "run",
        "forge",
        "--",
        "help"
      ],
      "dependsOn": "Forge: Restore Local Tool",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "NUGET_PACKAGES": "${workspaceFolder}/artifacts/local-tool/restore/dev/packages"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Forge: Validate ExampleMod",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "tool",
        "run",
        "forge",
        "--",
        "validate",
        "fixtures/projects/ExampleMod",
        "--format",
        "plain",
        "--no-input"
      ],
      "dependsOn": "Forge: Restore Local Tool",
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "NUGET_PACKAGES": "${workspaceFolder}/artifacts/local-tool/restore/dev/packages"
        }
      },
      "problemMatcher": {
        "owner": "wastelandforge",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "severity": "error",
        "pattern": {
          "regexp": "^ERR\\s+(WF-[A-Z]+-\\d+)\\s+([^#\\s]+)(?:#\\S+)?\\s+(.*)$",
          "code": 1,
          "file": 2,
          "message": 3
        }
      }
    },
    {
      "label": "Forge: Capabilities List",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "tool",
        "run",
        "forge",
        "--",
        "capabilities",
        "list",
        "--format",
        "plain",
        "--no-input"
      ],
      "dependsOn": "Forge: Restore Local Tool",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "NUGET_PACKAGES": "${workspaceFolder}/artifacts/local-tool/restore/dev/packages"
        }
      },
      "problemMatcher": []
    }
  ]
}
