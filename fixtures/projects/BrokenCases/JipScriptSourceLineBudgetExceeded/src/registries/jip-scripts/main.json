{
  "schemaVersion": "0.1.0",
  "kind": "jip-script",
  "id": "io.github.theboyyss.jipscriptsourcelinebudgetexceeded.jip_scripts",
  "scripts": [
    {
      "id": "io.github.theboyyss.jipscriptsourcelinebudgetexceeded.jip_scripts.bootstrap",
      "summary": "Synthetic JIP LN text-script source line byte budget fixture.",
      "lifecyclePrefix": "gr_",
      "outputFile": "gr_budget_exceeded.txt",
      "requires": {
        "capabilities": [
          {
            "id": "runtime.scripting.jip_script_runner"
          }
        ]
      },
      "sizePolicy": {
        "maxBytes": 2
      },
      "formIdResolution": {
        "strategy": "explicitReferences"
      },
      "body": {
        "lineMode": "opaqueText",
        "lines": [
          {
            "text": "abc"
          }
        ]
      }
    }
  ]
}
