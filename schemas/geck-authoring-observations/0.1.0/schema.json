{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wastelandforge.dev/fnv/geck-authoring-observations/0.1.0/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "kind", "source", "target", "completion", "observations", "safety"],
  "properties": {
    "formatVersion": { "const": "0.1.0" },
    "kind": { "const": "wastelandforge.geck-authoring-observations" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic", "usesRealPluginBytes"],
      "properties": {
        "synthetic": { "type": "boolean" },
        "usesRealPluginBytes": { "type": "boolean" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedPlugin", "observedPlugin"],
      "properties": {
        "expectedPlugin": { "$ref": "#/$defs/pluginName" },
        "observedPlugin": { "$ref": "#/$defs/pluginName" }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "recordsVisited", "refusals"],
      "properties": {
        "complete": { "type": "boolean" },
        "recordsVisited": { "type": "integer", "minimum": 0 },
        "refusals": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderedMasters", "containers", "references", "unexpectedRecords"],
      "properties": {
        "orderedMasters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pluginName" }
        },
        "containers": {
          "type": "array",
          "items": { "$ref": "#/$defs/container" }
        },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" }
        },
        "unexpectedRecords": {
          "type": "array",
          "items": { "$ref": "#/$defs/recordIdentity" }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOnly", "forgeExecutedXEdit", "mutatedPlugin", "wrotePlugin", "changedLoadOrder", "wroteGameData"],
      "properties": {
        "readOnly": { "const": true },
        "forgeExecutedXEdit": { "const": false },
        "mutatedPlugin": { "const": false },
        "wrotePlugin": { "const": false },
        "changedLoadOrder": { "const": false },
        "wroteGameData": { "const": false }
      }
    }
  },
  "$defs": {
    "pluginName": { "type": "string", "pattern": "^[^\\/:*?\"<>|]+\\.(esm|esp|esl)$" },
    "formId": { "type": "string", "pattern": "^[0-9A-F]{8}$" },
    "signature": { "type": "string", "pattern": "^[A-Z0-9_]{4}$" },
    "recordIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordFile", "signature", "fixedFormId"],
      "properties": {
        "recordFile": { "$ref": "#/$defs/pluginName" },
        "signature": { "$ref": "#/$defs/signature" },
        "fixedFormId": { "$ref": "#/$defs/formId" },
        "editorId": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordFile", "signature", "fixedFormId", "editorId", "quantity"],
      "properties": {
        "recordFile": { "$ref": "#/$defs/pluginName" },
        "signature": { "$ref": "#/$defs/signature" },
        "fixedFormId": { "$ref": "#/$defs/formId" },
        "editorId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "quantity": { "type": "integer", "minimum": 1 }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordFile", "signature", "fixedFormId", "editorId", "respawns", "items"],
      "properties": {
        "recordFile": { "$ref": "#/$defs/pluginName" },
        "signature": { "const": "CONT" },
        "fixedFormId": { "$ref": "#/$defs/formId" },
        "editorId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "respawns": { "type": "boolean" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordFile", "signature", "fixedFormId", "editorId", "baseRecord", "cell", "position", "rotation", "ownershipPresent", "persistent", "encounterZonePresent", "encounterZone"],
      "properties": {
        "recordFile": { "$ref": "#/$defs/pluginName" },
        "signature": { "const": "REFR" },
        "fixedFormId": { "$ref": "#/$defs/formId" },
        "editorId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "baseRecord": { "$ref": "#/$defs/recordIdentity" },
        "cell": { "$ref": "#/$defs/recordIdentity" },
        "position": { "$ref": "#/$defs/vector" },
        "rotation": { "$ref": "#/$defs/vector" },
        "ownershipPresent": { "type": "boolean" },
        "persistent": { "type": "boolean" },
        "encounterZonePresent": { "type": "boolean" },
        "encounterZone": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/recordIdentity" }
          ]
        }
      }
    }
  }
}
