<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <AssemblyName>WastelandForge</AssemblyName>
    <RootNamespace>WastelandForge.Desktop</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup Condition="'$(HeatSourceRoot)' != '' and Exists('$(HeatSourceRoot)')">
    <Resource Include="$(HeatSourceRoot)\Textures\Borders\Special\Cross Frame.png" Link="Assets\Heat\Cross Frame.png" Condition="Exists('$(HeatSourceRoot)\Textures\Borders\Special\Cross Frame.png')" />
    <Resource Include="$(HeatSourceRoot)\Fonts\RobotoCondensed-Regular.ttf" Link="Assets\Heat\RobotoCondensed-Regular.ttf" Condition="Exists('$(HeatSourceRoot)\Fonts\RobotoCondensed-Regular.ttf')" />
    <Resource Include="$(HeatSourceRoot)\Fonts\RobotoCondensed-Bold.ttf" Link="Assets\Heat\RobotoCondensed-Bold.ttf" Condition="Exists('$(HeatSourceRoot)\Fonts\RobotoCondensed-Bold.ttf')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WastelandForge.Generation\WastelandForge.Generation.csproj" />
    <ProjectReference Include="..\WastelandForge.Validation\WastelandForge.Validation.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\integrations\mo2\wastelandforge_bridge')">
    <Content Include="$(MSBuildProjectDirectory)\..\..\integrations\mo2\wastelandforge_bridge\**\*.*"
             Link="Integrations\MO2\wastelandforge_bridge\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyForgeBackendToOutputDirectory" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\..\dist\local\forge')">
    <ItemGroup>
      <ForgeBackendOutputFiles Include="$(MSBuildProjectDirectory)\..\..\dist\local\forge\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ForgeBackendOutputFiles)"
          DestinationFiles="@(ForgeBackendOutputFiles->'$(TargetDir)ForgeBackend\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyForgeBackendToPublishDirectory" AfterTargets="Publish" Condition="Exists('$(MSBuildProjectDirectory)\..\..\dist\local\forge')">
    <ItemGroup>
      <ForgeBackendPublishFiles Include="$(MSBuildProjectDirectory)\..\..\dist\local\forge\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ForgeBackendPublishFiles)"
          DestinationFiles="@(ForgeBackendPublishFiles->'$(PublishDir)ForgeBackend\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyDemoProjectToOutputDirectory" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\..\fixtures\projects\ExampleMod')">
    <ItemGroup>
      <DemoProjectOutputFiles Include="$(MSBuildProjectDirectory)\..\..\fixtures\projects\ExampleMod\**\*.*"
                              Exclude="$(MSBuildProjectDirectory)\..\..\fixtures\projects\ExampleMod\generated\**\*.*;$(MSBuildProjectDirectory)\..\..\fixtures\projects\ExampleMod\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DemoProjectOutputFiles)"
          DestinationFiles="@(DemoProjectOutputFiles->'$(TargetDir)DemoProjects\ExampleMod\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <XEditDemoOutputFiles Include="$(MSBuildProjectDirectory)\..\..\fixtures\projects\XEditAuditExample\**\*.*" />
      <CombinedDemoOutputFiles Include="$(MSBuildProjectDirectory)\..\..\fixtures\projects\CombinedModExample\**\*.*" Exclude="$(MSBuildProjectDirectory)\..\..\fixtures\projects\CombinedModExample\generated\**\*.*;$(MSBuildProjectDirectory)\..\..\fixtures\projects\CombinedModExample\dist\**\*.*" />
      <GeckAuthoringDemoOutputFiles Include="$(MSBuildProjectDirectory)\..\..\fixtures\projects\GeckAuthoringPlanExample\**\*.*" Exclude="$(MSBuildProjectDirectory)\..\..\fixtures\projects\GeckAuthoringPlanExample\generated\**\*.*;$(MSBuildProjectDirectory)\..\..\fixtures\projects\GeckAuthoringPlanExample\dist\**\*.*" />
      <GeckAuthoringObservationOutputFile Include="$(MSBuildProjectDirectory)\..\..\fixtures\geck-authoring-observations\valid-first-slice.json" />
    </ItemGroup>
    <Copy SourceFiles="@(XEditDemoOutputFiles)" DestinationFiles="@(XEditDemoOutputFiles->'$(TargetDir)DemoProjects\XEditAuditExample\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CombinedDemoOutputFiles)" DestinationFiles="@(CombinedDemoOutputFiles->'$(TargetDir)DemoProjects\CombinedModExample\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GeckAuthoringDemoOutputFiles)" DestinationFiles="@(GeckAuthoringDemoOutputFiles->'$(TargetDir)DemoProjects\GeckAuthoringPlanExample\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GeckAuthoringObservationOutputFile)" DestinationFolder="$(TargetDir)DemoProjects\GeckAuthoringPlanExample\evidence" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyDemoProjectToPublishDirectory" AfterTargets="Publish" Condition="Exists('$(MSBuildProjectDirectory)\..\..\fixtures\projects\ExampleMod')">
    <ItemGroup>
      <DemoProjectPublishFiles Include="$(MSBuildProjectDirectory)\..\..\fixtures\projects\ExampleMod\**\*.*"
                               Exclude="$(MSBuildProjectDirectory)\..\..\fixtures\projects\ExampleMod\generated\**\*.*;$(MSBuildProjectDirectory)\..\..\fixtures\projects\ExampleMod\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DemoProjectPublishFiles)"
          DestinationFiles="@(DemoProjectPublishFiles->'$(PublishDir)DemoProjects\ExampleMod\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <XEditDemoPublishFiles Include="$(MSBuildProjectDirectory)\..\..\fixtures\projects\XEditAuditExample\**\*.*" />
      <CombinedDemoPublishFiles Include="$(MSBuildProjectDirectory)\..\..\fixtures\projects\CombinedModExample\**\*.*" Exclude="$(MSBuildProjectDirectory)\..\..\fixtures\projects\CombinedModExample\generated\**\*.*;$(MSBuildProjectDirectory)\..\..\fixtures\projects\CombinedModExample\dist\**\*.*" />
      <GeckAuthoringDemoPublishFiles Include="$(MSBuildProjectDirectory)\..\..\fixtures\projects\GeckAuthoringPlanExample\**\*.*" Exclude="$(MSBuildProjectDirectory)\..\..\fixtures\projects\GeckAuthoringPlanExample\generated\**\*.*;$(MSBuildProjectDirectory)\..\..\fixtures\projects\GeckAuthoringPlanExample\dist\**\*.*" />
      <GeckAuthoringObservationPublishFile Include="$(MSBuildProjectDirectory)\..\..\fixtures\geck-authoring-observations\valid-first-slice.json" />
    </ItemGroup>
    <Copy SourceFiles="@(XEditDemoPublishFiles)" DestinationFiles="@(XEditDemoPublishFiles->'$(PublishDir)DemoProjects\XEditAuditExample\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CombinedDemoPublishFiles)" DestinationFiles="@(CombinedDemoPublishFiles->'$(PublishDir)DemoProjects\CombinedModExample\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GeckAuthoringDemoPublishFiles)" DestinationFiles="@(GeckAuthoringDemoPublishFiles->'$(PublishDir)DemoProjects\GeckAuthoringPlanExample\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GeckAuthoringObservationPublishFile)" DestinationFolder="$(PublishDir)DemoProjects\GeckAuthoringPlanExample\evidence" SkipUnchangedFiles="true" />
  </Target>

</Project>
