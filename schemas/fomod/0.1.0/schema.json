{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.wastelandforge.dev/fnv/fomod/0.1.0/schema.json","type":"object","additionalProperties":false,"required":["schemaVersion","kind","id","name","author","version","description","installerVersion"],
  "properties":{"schemaVersion":{"const":"0.1.0"},"kind":{"const":"fomod"},"id":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"},"name":{"type":"string","minLength":1},"author":{"type":"string","minLength":1},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},"displayVersion":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"website":{"type":"string","format":"uri","pattern":"^https?://"},"moduleName":{"type":"string","minLength":1},"installerVersion":{"const":"5.0"}}
}
