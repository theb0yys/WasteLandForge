                  <ComboBoxItem Content="Checkbox" Tag="checkbox" />
                  <ComboBoxItem Content="String toggle" Tag="stringToggle" />
                  <ComboBoxItem Content="Slider" Tag="slider" />
                  <ComboBoxItem Content="Choice" Tag="choice" />
                  <ComboBoxItem Content="Keybind" Tag="keybind" />
                  <ComboBoxItem Content="Header" Tag="header" />
                  <ComboBoxItem Content="Static text" Tag="text" />
                </ComboBox>
                <TextBlock Text="Setting label" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="McmSettingLabelTextBox" Text="Enable feature" Margin="0,6,0,0" TextChanged="McmAppendInputChanged" />
                <StackPanel x:Name="McmIniFieldsPanel">
                  <TextBlock Text="INI file" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="McmIniFileTextBox" Text="Config/MyMod.ini" Margin="0,6,0,0" TextChanged="McmAppendInputChanged" />
                  <TextBlock Text="INI section" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="McmIniSectionTextBox" Text="General" Margin="0,6,0,0" TextChanged="McmAppendInputChanged" />
                  <TextBlock Text="INI key" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="McmIniKeyTextBox" Text="bEnabled" Margin="0,6,0,0" TextChanged="McmAppendInputChanged" />
