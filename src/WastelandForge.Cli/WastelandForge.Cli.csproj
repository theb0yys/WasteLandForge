<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>forge</ToolCommandName>
    <PackageId>WastelandForge.Cli</PackageId>
    <Authors>WastelandForge contributors</Authors>
    <Description>Offline-first WastelandForge CLI for validation, capability inspection, generation, packaging, and release dry-run workflows.</Description>
    <PackageTags>wastelandforge;fallout-new-vegas;modding;cli;tool</PackageTags>
    <PackageReadmeFile>PACKAGE-README.md</PackageReadmeFile>
    <PackageOutputPath>..\..\artifacts\local-tool\nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE-README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WastelandForge.Core\WastelandForge.Core.csproj" />
    <ProjectReference Include="..\WastelandForge.Schema\WastelandForge.Schema.csproj" />
    <ProjectReference Include="..\WastelandForge.Registry\WastelandForge.Registry.csproj" />
    <ProjectReference Include="..\WastelandForge.Validation\WastelandForge.Validation.csproj" />
    <ProjectReference Include="..\WastelandForge.Generation\WastelandForge.Generation.csproj" />
    <ProjectReference Include="..\WastelandForge.Provenance\WastelandForge.Provenance.csproj" />
  </ItemGroup>

</Project>
