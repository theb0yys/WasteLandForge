{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wastelandforge.dev/fnv/fnv-game-knowledge-receipt/0.2.0/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "kind", "createdAtUtc", "sourceClassification", "record", "provenance", "limitations"],
  "properties": {
    "formatVersion": { "const": "0.2.0" },
    "kind": { "const": "wastelandforge.fnv-game-knowledge-receipt" },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "sourceClassification": { "const": "local-only" },
    "record": { "$ref": "#/$defs/record" },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "provider", "master", "script", "export"],
      "properties": { "index": { "$ref": "#/$defs/digest" }, "provider": { "$ref": "#/$defs/digest" }, "master": { "$ref": "#/$defs/digest" }, "script": { "$ref": "#/$defs/digest" }, "export": { "$ref": "#/$defs/digest" } }
    },
    "limitations": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "formId": { "type": "string", "pattern": "^[0-9A-F]{8}$" },
    "signature": { "type": "string", "pattern": "^[A-Z0-9_]{4}$" },
    "digest": { "type": "object", "additionalProperties": false, "required": ["fileName", "length", "sha256"], "properties": { "fileName": { "$ref": "#/$defs/text" }, "length": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha" } } },
    "identity": { "type": "object", "additionalProperties": false, "required": ["sourceFile", "signature", "fixedFormId"], "properties": { "sourceFile": { "const": "FalloutNV.esm" }, "signature": { "$ref": "#/$defs/signature" }, "fixedFormId": { "$ref": "#/$defs/formId" }, "editorId": { "$ref": "#/$defs/text" } } },
    "vector": { "type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } } },
    "context": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "interior"], "properties": { "kind": { "const": "cell" }, "interior": { "type": "boolean" }, "gridX": { "type": "integer" }, "gridY": { "type": "integer" }, "worldspace": { "$ref": "#/$defs/identity" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "worldspace" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "baseRecord", "position", "rotation"], "properties": { "kind": { "const": "reference" }, "baseRecord": { "$ref": "#/$defs/identity" }, "cell": { "$ref": "#/$defs/identity" }, "worldspace": { "$ref": "#/$defs/identity" }, "position": { "$ref": "#/$defs/vector" }, "rotation": { "$ref": "#/$defs/vector" } } }
      ]
    },
    "record": { "type": "object", "additionalProperties": false, "required": ["sourceFile", "signature", "fixedFormId", "isDeleted"], "properties": { "sourceFile": { "const": "FalloutNV.esm" }, "signature": { "$ref": "#/$defs/signature" }, "fixedFormId": { "$ref": "#/$defs/formId" }, "loadOrderFormId": { "$ref": "#/$defs/formId" }, "editorId": { "$ref": "#/$defs/text" }, "displayName": { "$ref": "#/$defs/text" }, "isDeleted": { "type": "boolean" }, "context": { "$ref": "#/$defs/context" } } }
  }
}
