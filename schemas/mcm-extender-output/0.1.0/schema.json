{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wastelandforge.dev/fnv/mcm-extender-output/0.1.0/schema.json",
  "title": "WastelandForge MCM Extender Output",
  "description": "Minimal MCM Extender runtime JSON subset emitted by WastelandForge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modName",
    "displayName",
    "saveFile",
    "minMCMVersion",
    "submenus"
  ],
  "properties": {
    "modName": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "displayName": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "description": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "saveFile": {
      "$ref": "#/$defs/relativePath"
    },
    "minMCMVersion": {
      "type": "number",
      "minimum": 0
    },
    "requirements": {
      "$ref": "#/$defs/requirements"
    },
    "submenus": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 10,
      "additionalProperties": false,
      "patternProperties": {
        "^(?:0|[1-9]|10)$": {
          "$ref": "#/$defs/submenu"
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(?:[a-zA-Z]:|/|\\\\\\\\)"
      }
    },
    "integerKeyedOptions": {
      "type": "object",
      "maxProperties": 36,
      "additionalProperties": false,
      "patternProperties": {
        "^(?:[1-9]|[1-2][0-9]|3[0-6])$": {
          "$ref": "#/$defs/option"
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/requirement"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/requirement"
            },
            "minItems": 1
          }
        ]
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "plugin",
            "file",
            "folder",
            "dll",
            "nvse"
          ]
        },
        "file": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "type": "number"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "plugin",
                  "file",
                  "folder",
                  "dll"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "file"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "dll",
                  "nvse"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "version"
            ]
          }
        }
      ]
    },
    "submenu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "listTitle",
        "pageTitle",
        "options"
      ],
      "properties": {
        "columns": {
          "enum": [
            1,
            2
          ]
        },
        "listTitle": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "pageTitle": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "options": {
          "$ref": "#/$defs/integerKeyedOptions"
        },
        "enable": {
          "enum": [
            0,
            1
          ]
        },
        "active": {
          "enum": [
            0,
            1
          ]
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title"
      ],
      "properties": {
        "type": {
          "enum": [
            0,
            1,
            2,
            2.5,
            3,
            4,
            5,
            6,
            7
          ]
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "enable": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "mouse": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "refresh": {
          "enum": [
            0,
            1
          ]
        },
        "vars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          },
          "minItems": 1
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "prefix": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "suffix": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "strings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "maxItems": 10
        },
        "string": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "textOn": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "textOff": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "image": {
          "$ref": "#/$defs/image"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": 1
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "strings",
              "vars"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  2,
                  2.5
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "vars",
              "scale"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  3,
                  4,
                  5,
                  6
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "vars"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": 7
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "string"
            ]
          }
        }
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "width",
        "height",
        "systemcolor"
      ],
      "properties": {
        "filename": {
          "$ref": "#/$defs/relativePath"
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "systemcolor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "offsetX": {
          "type": "integer"
        },
        "offsetY": {
          "type": "integer"
        }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valueDecimal",
        "valueIncrement",
        "valueMin",
        "valueMax"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "valueIncrement": {
          "type": "number"
        },
        "valueDecimal": {
          "type": "integer",
          "minimum": 0
        },
        "valueMin": {
          "type": "number"
        },
        "valueMax": {
          "type": "number"
        }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "type": "number"
        },
        "configINI": {
          "type": "string",
          "pattern": "^[^:]+:[^:]+$"
        },
        "iniPath": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  },
  "examples": [
    {
      "modName": "io.github.theboyyss.examplemod.mcm.main",
      "displayName": "Example Mod",
      "saveFile": "ExampleMod.ini",
      "minMCMVersion": 1.0,
      "requirements": [
        {
          "type": "file",
          "file": "Config/ExampleMod.ini"
        }
      ],
      "submenus": {
        "0": {
          "columns": 1,
          "listTitle": "General",
          "pageTitle": "General",
          "options": {
            "1": {
              "type": 0,
              "title": "Example Settings"
            },
            "2": {
              "type": 4,
              "title": "Enable Example Feature",
              "vars": [
                {
                  "configINI": "General:bEnableExampleFeature",
                  "default": 1
                }
              ]
            },
            "3": {
              "type": 5,
              "title": "Show Hints",
              "vars": [
                {
                  "configINI": "General:bShowHints",
                  "default": 1
                }
              ]
            },
            "4": {
              "type": 6,
              "title": "HUD Mode",
              "textOn": "Compact",
              "textOff": "Full",
              "vars": [
                {
                  "configINI": "General:bCompactHud",
                  "default": 0
                }
              ]
            },
            "5": {
              "type": 3,
              "title": "Quick Menu Key",
              "vars": [
                {
                  "configINI": "General:iQuickMenuKey",
                  "default": 33
                }
              ]
            },
            "6": {
              "type": 0,
              "title": "Example Logo",
              "image": {
                "filename": "textures/interface/ExampleMod/Logo.dds",
                "width": 256,
                "height": 64,
                "systemcolor": 0,
                "offsetX": 0,
                "offsetY": 0
              }
            }
          }
        }
      }
    }
  ]
}
