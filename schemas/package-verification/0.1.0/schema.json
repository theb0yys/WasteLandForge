{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wastelandforge.dev/fnv/package-verification/0.1.0/schema.json",
  "title": "WastelandForge Package Verification",
  "description": "Local package verification report for generated WastelandForge MCM Extender loose-file packages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "kind",
    "verificationType",
    "command",
    "target",
    "dryRun",
    "project",
    "package",
    "checks",
    "archive",
    "result",
    "limitations"
  ],
  "properties": {
    "formatVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "wastelandforge.package-verification"
    },
    "verificationType": {
      "const": "wastelandforge/mcm-json-loose-file-package-verification/v1"
    },
    "command": {
      "enum": [
        "generate",
        "build",
        "package"
      ]
    },
    "target": {
      "const": "mcm-json"
    },
    "dryRun": {
      "type": "boolean"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "package": {
      "$ref": "#/$defs/packageSummary"
    },
    "checks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/packageManifestSchemaCheck"
        },
        {
          "$ref": "#/$defs/installPreviewSchemaCheck"
        },
        {
          "$ref": "#/$defs/installPreviewSummaryCheck"
        },
        {
          "$ref": "#/$defs/packagePayloadDigestsCheck"
        },
        {
          "oneOf": [
            {
              "$ref": "#/$defs/archiveNotCreatedCheck"
            },
            {
              "$ref": "#/$defs/archiveCreatedCheck"
            }
          ]
        }
      ]
    },
    "archive": {
      "oneOf": [
        {
          "$ref": "#/$defs/archiveNotCreated"
        },
        {
          "$ref": "#/$defs/archiveCreated"
        }
      ]
    },
    "result": {
      "const": "passed"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(?:[a-zA-Z]:|/|\\\\\\\\)"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageType",
        "root",
        "layout",
        "entries",
        "menus",
        "translations",
        "assets"
      ],
      "properties": {
        "packageType": {
          "const": "wastelandforge/mcm-json-loose-files/v1"
        },
        "root": {
          "$ref": "#/$defs/relativePath"
        },
        "layout": {
          "const": "fallout-new-vegas-data-loose-files"
        },
        "entries": {
          "type": "integer",
          "minimum": 1
        },
        "menus": {
          "type": "integer",
          "minimum": 1
        },
        "translations": {
          "type": "integer",
          "minimum": 0
        },
        "assets": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "packageManifestSchemaCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "const": "package-manifest-schema"
        },
        "status": {
          "const": "passed"
        },
        "evidence": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "installPreviewSchemaCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "const": "install-preview-schema"
        },
        "status": {
          "const": "passed"
        },
        "evidence": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "installPreviewSummaryCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "const": "install-preview-summary"
        },
        "status": {
          "const": "written"
        },
        "evidence": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "packagePayloadDigestsCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "count"
      ],
      "properties": {
        "id": {
          "const": "package-payload-digests"
        },
        "status": {
          "const": "recorded"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "archiveNotCreatedCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "validation"
      ],
      "properties": {
        "id": {
          "const": "package-archive"
        },
        "status": {
          "const": "not-created"
        },
        "validation": {
          "const": "not-applicable"
        }
      }
    },
    "archiveCreatedCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "validation"
      ],
      "properties": {
        "id": {
          "const": "package-archive"
        },
        "status": {
          "const": "created"
        },
        "validation": {
          "const": "entries-matched"
        }
      }
    },
    "archiveNotCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "validation",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "not-created"
        },
        "validation": {
          "const": "not-applicable"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "archiveCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "validation",
        "outputFile",
        "mediaType",
        "compression",
        "sha256",
        "length"
      ],
      "properties": {
        "status": {
          "const": "created"
        },
        "validation": {
          "const": "entries-matched"
        },
        "outputFile": {
          "$ref": "#/$defs/relativePath"
        },
        "mediaType": {
          "const": "application/zip"
        },
        "compression": {
          "const": "store"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "length": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
