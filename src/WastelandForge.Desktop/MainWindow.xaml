                <DataGridCheckBoxColumn Header="Generated" Binding="{Binding GeneratedExists}" Width="100" />
                <DataGridCheckBoxColumn Header="Distribution" Binding="{Binding DistributionExists}" Width="110" />
                <DataGridTextColumn Header="Canonical command" Binding="{Binding Command}" Width="280" />
                <DataGridTextColumn Header="Components" Binding="{Binding Components}" Width="150" />
                <DataGridTextColumn Header="Entries" Binding="{Binding EntryCount}" Width="70" />
              </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
