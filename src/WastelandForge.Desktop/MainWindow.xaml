                </Grid>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,4,0"><TextBlock Text="Rotation X" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="GeckIntentRotationXTextBox" AutomationProperties.AutomationId="GeckIntentRotationXTextBox" TextChanged="GeckIntentBuilderInputChanged" /></StackPanel><StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Y" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="GeckIntentRotationYTextBox" AutomationProperties.AutomationId="GeckIntentRotationYTextBox" TextChanged="GeckIntentBuilderInputChanged" /></StackPanel><StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Z" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="GeckIntentRotationZTextBox" AutomationProperties.AutomationId="GeckIntentRotationZTextBox" TextChanged="GeckIntentBuilderInputChanged" /></StackPanel>
                </Grid>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><CheckBox x:Name="GeckIntentPersistentCheckBox" AutomationProperties.AutomationId="GeckIntentPersistentCheckBox" Content="Persistent" Checked="GeckIntentBuilderInputChanged" Unchecked="GeckIntentBuilderInputChanged" /><ComboBox x:Name="GeckIntentEncounterPolicyComboBox" AutomationProperties.AutomationId="GeckIntentEncounterPolicyComboBox" Grid.Column="1" Margin="12,0,0,0" SelectionChanged="GeckIntentBuilderInputChanged"><ComboBoxItem Content="Inherit cell encounter zone" Tag="inherit-cell" IsSelected="True" /><ComboBoxItem Content="No encounter zone" Tag="none" /></ComboBox></Grid>
              </StackPanel>

              <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="260" /><RowDefinition Height="170" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <WrapPanel>
                  <Button x:Name="PreviewGeckIntentButton" AutomationProperties.AutomationId="PreviewGeckIntentButton" Content="Preview" Click="PreviewGeckIntentClicked" />
                  <Button x:Name="ApplyGeckIntentButton" AutomationProperties.AutomationId="ApplyGeckIntentButton" Content="Apply Source" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="8,0,0,0" Click="ApplyGeckIntentClicked" />
                  <Button x:Name="CancelGeckIntentOperationButton" AutomationProperties.AutomationId="CancelGeckIntentOperationButton" Content="Cancel" IsEnabled="False" Margin="8,0,0,0" Click="CancelGeckIntentOperationClicked" />
                  <Button x:Name="ReviewGeckIntentUndoButton" AutomationProperties.AutomationId="ReviewGeckIntentUndoButton" Content="Review Undo" Margin="8,0,0,0" Click="ReviewGeckIntentUndoClicked" />
                  <Button x:Name="UndoGeckIntentButton" AutomationProperties.AutomationId="UndoGeckIntentButton" Content="Undo" IsEnabled="False" Margin="8,0,0,0" Click="UndoGeckIntentClicked" />
                  <Button x:Name="OpenGeckAuthoringReviewButton" AutomationProperties.AutomationId="OpenGeckAuthoringReviewButton" Content="Open Authoring Review" IsEnabled="False" Margin="8,0,0,0" Click="OpenGeckAuthoringReviewClicked" />
                  <Button x:Name="RouteGeckIntentValidationButton" AutomationProperties.AutomationId="RouteGeckIntentValidationButton" Content="Open Validation" Margin="8,0,0,0" Click="RouteGeckIntentValidationClicked" />
                </WrapPanel>
                <TextBox x:Name="GeckIntentPreviewTextBox" AutomationProperties.AutomationId="GeckIntentPreviewTextBox" Grid.Row="1" Margin="0,12,0,0" AcceptsReturn="True" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                <DataGrid x:Name="GeckIntentDiagnosticsDataGrid" AutomationProperties.AutomationId="GeckIntentDiagnosticsDataGrid" Grid.Row="2" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="105" /><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80" /><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" /></DataGrid.Columns></DataGrid>
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                  <TextBlock x:Name="GeckIntentStatusTextBlock" AutomationProperties.AutomationId="GeckIntentStatusTextBlock" Text="Refresh the selected project." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                  <WrapPanel Margin="0,8,0,0"><Button x:Name="ReviewGeckIntentRecoveryButton" Content="Review Recovery" Click="ReviewGeckIntentRecoveryClicked" /><Button x:Name="ResumeGeckIntentRecoveryButton" Content="Resume Validation" IsEnabled="False" Margin="8,0,0,0" Click="ResumeGeckIntentRecoveryClicked" /><Button x:Name="RestoreGeckIntentOriginalButton" Content="Restore Original" IsEnabled="False" Margin="8,0,0,0" Click="RestoreGeckIntentOriginalClicked" /></WrapPanel>
                </StackPanel>
              </Grid>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="GameKnowledgeTabItem" Header="Game Knowledge" AutomationProperties.AutomationId="GameKnowledgeTabItem">
          <ScrollViewer x:Name="GameKnowledgeScrollViewer" AutomationProperties.AutomationId="GameKnowledgeScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="0,18,0,0" MinHeight="460">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="3*" MinHeight="120" />
              <RowDefinition Height="2*" MinHeight="100" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Fallout: New Vegas game knowledge" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="GameKnowledgeStateTextBlock" AutomationProperties.AutomationId="GameKnowledgeStateTextBlock" Text="Not configured" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,5,0,0" />
              </StackPanel>
              <WrapPanel Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Left">
                <Button x:Name="RefreshGameKnowledgeButton" AutomationProperties.AutomationId="RefreshGameKnowledgeButton" Content="Refresh" Click="RefreshGameKnowledgeClicked" />
                <Button x:Name="PrepareGameKnowledgeExportButton" AutomationProperties.AutomationId="PrepareGameKnowledgeExportButton" Content="Prepare Export" Margin="8,0,0,0" Click="PrepareGameKnowledgeExportClicked" />
                <Button x:Name="PreparePrivateGameKnowledgeRunButton" AutomationProperties.AutomationId="PreparePrivateGameKnowledgeRunButton" Content="Preview Private xEdit Run" Margin="8,0,0,0" Click="PreparePrivateGameKnowledgeRunClicked" />
                <Button x:Name="RunGameKnowledgeExportButton" AutomationProperties.AutomationId="RunGameKnowledgeExportButton" Content="Run Export" Margin="8,0,0,0" IsEnabled="False" Style="{StaticResource PrimaryButton}" Click="RunGameKnowledgeExportClicked" />
                <Button x:Name="ImportGameKnowledgeExportButton" AutomationProperties.AutomationId="ImportGameKnowledgeExportButton" Content="Import Export" Margin="8,0,0,0" Click="ImportGameKnowledgeExportClicked" />
                <Button x:Name="RebuildGameKnowledgeButton" AutomationProperties.AutomationId="RebuildGameKnowledgeButton" Content="Rebuild" Margin="8,0,0,0" Click="PrepareGameKnowledgeExportClicked" />
              </WrapPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,14,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
              <TextBox x:Name="GameKnowledgeSearchTextBox" AutomationProperties.AutomationId="GameKnowledgeSearchTextBox" TextChanged="GameKnowledgeSearchChanged" />
              <ComboBox x:Name="GameKnowledgeSignatureComboBox" AutomationProperties.AutomationId="GameKnowledgeSignatureComboBox" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="GameKnowledgeSearchChanged" />
              <ComboBox x:Name="GameKnowledgeContextComboBox" AutomationProperties.AutomationId="GameKnowledgeContextComboBox" Grid.Column="2" Margin="8,0,0,0" SelectionChanged="GameKnowledgeSearchChanged">
                <ComboBoxItem Content="All contexts" Tag="all" IsSelected="True" />
                <ComboBoxItem Content="Locations" Tag="location" />
                <ComboBoxItem Content="Cells" Tag="cell" />
                <ComboBoxItem Content="Worldspaces" Tag="worldspace" />
                <ComboBoxItem Content="Placed references" Tag="reference" />
                <ComboBoxItem Content="No context" Tag="none" />
              </ComboBox>
            </Grid>

            <DataGrid x:Name="GameKnowledgeResultsDataGrid" AutomationProperties.AutomationId="GameKnowledgeResultsDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionChanged="GameKnowledgeSelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding Signature}" Width="62" />
                <DataGridTextColumn Header="EditorID" Binding="{Binding EditorId}" Width="1.3*" />
                <DataGridTextColumn Header="FormID" Binding="{Binding FixedFormId}" Width="90" />
                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="1.2*" />
                <DataGridTextColumn Header="Source" Binding="{Binding SourceFile}" Width="115" />
                <DataGridTextColumn Header="Context" Binding="{Binding ContextSummary}" Width="1.4*" />
              </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3" Margin="0,12,0,0">
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBox x:Name="GameKnowledgeDetailsTextBox" AutomationProperties.AutomationId="GameKnowledgeDetailsTextBox" AcceptsReturn="True" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
              <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                <Button x:Name="CopyGameKnowledgeEditorIdButton" AutomationProperties.AutomationId="CopyGameKnowledgeEditorIdButton" Content="Copy EditorID" IsEnabled="False" Click="CopyGameKnowledgeEditorIdClicked" />
                <Button x:Name="CopyGameKnowledgeFormIdButton" AutomationProperties.AutomationId="CopyGameKnowledgeFormIdButton" Content="Copy FormID" IsEnabled="False" Margin="8,0,0,0" Click="CopyGameKnowledgeFormIdClicked" />
                <Button x:Name="CreateGameKnowledgeReceiptButton" AutomationProperties.AutomationId="CreateGameKnowledgeReceiptButton" Content="Create Evidence Receipt" IsEnabled="False" Margin="8,0,0,0" Click="CreateGameKnowledgeReceiptClicked" />
                <ComboBox x:Name="GameKnowledgeIntentKindComboBox" AutomationProperties.AutomationId="GameKnowledgeIntentKindComboBox" Width="150" Margin="8,0,0,0" SelectionChanged="GameKnowledgeIntentKindChanged">
                  <ComboBoxItem Content="Choose intent kind" Tag="" IsSelected="True" />
                  <ComboBoxItem Content="Item" Tag="item" />
                  <ComboBoxItem Content="Cell" Tag="cell" />
                  <ComboBoxItem Content="Worldspace" Tag="worldspace" />
                  <ComboBoxItem Content="Container base" Tag="container-base" />
                </ComboBox>
                <Button x:Name="UseGameKnowledgeInIntentButton" AutomationProperties.AutomationId="UseGameKnowledgeInIntentButton" Content="Use in GECK Intent Builder" IsEnabled="False" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="UseGameKnowledgeInIntentClicked" />
              </WrapPanel>
            </Grid>

            <Grid Grid.Row="4" Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="GameKnowledgeStatusTextBlock" AutomationProperties.AutomationId="GameKnowledgeStatusTextBlock" Text="Refresh after configuring the local game and xEdit paths." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,7,0,0">
                  <Button Content="GECK ID glossary" Tag="https://geckwiki.com/index.php?title=Editor_ID" Click="OpenGameKnowledgeDocumentationClicked" />
                  <Button Content="GECK Object Window" Tag="https://geckwiki.com/index.php/Object_Window" Margin="8,0,0,0" Click="OpenGameKnowledgeDocumentationClicked" />
                  <Button Content="GECK form types" Tag="https://geckwiki.com/index.php/Form_Type_IDs" Margin="8,0,0,0" Click="OpenGameKnowledgeDocumentationClicked" />
                </WrapPanel>
              </StackPanel>
              <WrapPanel Grid.Column="1" VerticalAlignment="Bottom">
                <Button x:Name="PreviewClearGameKnowledgeButton" AutomationProperties.AutomationId="PreviewClearGameKnowledgeButton" Content="Preview Clear" Click="PreviewClearGameKnowledgeClicked" />
                <Button x:Name="ConfirmClearGameKnowledgeButton" AutomationProperties.AutomationId="ConfirmClearGameKnowledgeButton" Content="Confirm Clear" IsEnabled="False" Margin="8,0,0,0" Click="ConfirmClearGameKnowledgeClicked" />
              </WrapPanel>
            </Grid>
          </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="NewProjectTabItem" Header="New Project">
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="360" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,18,0">
              <StackPanel>
                <TextBlock Text="New Forge project" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="SemiBold" />

                <TextBlock Text="Project name" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" Margin="0,18,0,0" />
                <TextBox x:Name="NewProjectNameTextBox" Margin="0,7,0,0" TextChanged="NewProjectInputChanged" />

                <TextBlock Text="Target project folder" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" Margin="0,14,0,0" />
                <TextBox x:Name="NewProjectPathTextBox" Margin="0,7,0,0" TextChanged="NewProjectInputChanged" />
                <Button Content="Choose Parent Folder" Margin="0,8,0,0" Click="BrowseNewProjectParentClicked" />

                <TextBlock Text="Template" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" Margin="0,14,0,0" />
                <ComboBox x:Name="NewProjectTemplateComboBox"
                          Margin="0,7,0,0"
                          Padding="8"
                          SelectedIndex="0"
                          SelectionChanged="NewProjectInputChanged">
                  <ComboBoxItem Content="FNV Basic" Tag="fnv-basic" />
                  <ComboBoxItem Content="FNV Framework" Tag="fnv-framework" />
                  <ComboBoxItem Content="FNV Quest Pack" Tag="fnv-quest-pack" />
                  <ComboBoxItem Content="FNV Docs Only" Tag="fnv-docs-only" />
                </ComboBox>
                <TextBlock Text="FNV Framework creates runtime-enabled MCM and JIP source ready for combined packaging. The other templates retain the validated baseline scaffold."
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />

                <Button x:Name="PreviewNewProjectButton"
                        Content="Preview"
                        Margin="0,20,0,0"
                        Click="PreviewNewProjectClicked" />
                <Button x:Name="CreateProjectButton"
                        Content="Create Project"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,10,0,0"
                        IsEnabled="False"
                        Click="CreateNewProjectClicked" />
                <TextBlock x:Name="NewProjectStatusTextBlock"
                           Text="Preview the current inputs before creating files."
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <TextBox x:Name="NewProjectOutputTextBox"
                     Grid.Column="1"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="13"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     TextWrapping="NoWrap" />
          </Grid>
        </TabItem>

        <TabItem x:Name="NarrativeAuthorTabItem" Header="Narrative Author">
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="420" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,18,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Narrative Author" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="SemiBold" />
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="NarrativeInventoryStateTextBlock" Text="Inventory: Not loaded" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock x:Name="NarrativeInventorySummaryTextBlock" Text="Select a project and refresh inventory." Foreground="{StaticResource TextMuted}" Margin="0,3,8,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button x:Name="RefreshNarrativeInventoryButton" Grid.Column="1" Content="Refresh inventory" Click="RefreshNarrativeInventoryClicked" VerticalAlignment="Top" />
                </Grid>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
