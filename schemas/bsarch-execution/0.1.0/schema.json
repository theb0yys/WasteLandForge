{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wastelandforge.dev/fnv/bsarch-execution/0.1.0/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "kind", "status", "approvalSha256", "provider", "providerVersion", "archives", "invocations", "externalToolExecuted", "pluginMutation"],
  "properties": {
    "formatVersion": { "const": "0.1" },
    "kind": { "const": "wastelandforge.bsarch-execution" },
    "status": { "const": "passed" },
    "approvalSha256": { "$ref": "#/$defs/sha" },
    "provider": { "type": "object" },
    "providerVersion": { "type": "string", "minLength": 1 },
    "archives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/archive" } },
    "invocations": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/invocation" } },
    "externalToolExecuted": { "const": true },
    "pluginMutation": { "const": false }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "archive": { "type": "object", "additionalProperties": false, "required": ["archiveFile", "entryCount", "sha256", "length", "repeatPackMatches", "listMatches", "unpackedBytesMatch"], "properties": { "archiveFile": { "type": "string", "pattern": "\\.bsa$" }, "entryCount": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha" }, "length": { "type": "integer", "minimum": 1 }, "repeatPackMatches": { "const": true }, "listMatches": { "const": true }, "unpackedBytesMatch": { "const": true } } },
    "invocation": { "type": "object", "additionalProperties": false, "required": ["arguments", "exitCode", "timedOut", "standardOutputSha256", "standardOutputLength", "standardErrorSha256", "standardErrorLength"], "properties": { "arguments": { "type": "array", "items": { "type": "string" } }, "exitCode": { "type": "integer" }, "timedOut": { "type": "boolean" }, "standardOutputSha256": { "$ref": "#/$defs/sha" }, "standardOutputLength": { "type": "integer", "minimum": 0 }, "standardErrorSha256": { "$ref": "#/$defs/sha" }, "standardErrorLength": { "type": "integer", "minimum": 0 } } }
  }
}
