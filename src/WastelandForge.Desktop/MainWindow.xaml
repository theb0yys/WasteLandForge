<Window x:Class="WastelandForge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WastelandForge"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        Background="{StaticResource AppBackground}"
        Loaded="OnLoaded"
        Activated="WindowActivated">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="278" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="#12151A"
            BorderBrush="#303741"
            BorderThickness="0,0,1,0">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
          <Grid Width="72" Height="72" HorizontalAlignment="Left">
            <Ellipse Fill="#1D232A" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
            <TextBlock Text="WF"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Image x:Name="HeatAccentImage"
                   Stretch="Uniform"
                   Opacity="0.42"
                   Visibility="Collapsed" />
          </Grid>

          <TextBlock Text="WastelandForge"
                     Foreground="{StaticResource TextPrimary}"
                     FontSize="28"
                     FontWeight="Bold"
                     Margin="0,18,0,0" />
          <TextBlock Text="Premium Windows shell over the deterministic Forge backend."
                     Foreground="{StaticResource TextMuted}"
                     Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,34,0,0">
          <TextBlock Text="Shell"
                     Foreground="{StaticResource TextMuted}"
                     FontSize="12"
                     FontWeight="Bold" />
          <TextBlock x:Name="BackendStatusTextBlock"
                     Text="Backend not checked"
                     Foreground="{StaticResource TextPrimary}"
                     Margin="0,8,0,0" />
          <TextBlock x:Name="HeatStatusTextBlock"
                     Text="Heat UI skin not checked"
                     Margin="0,8,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="Build" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold" />
          <ComboBox x:Name="BuildWorkspaceComboBox" Margin="0,7,0,0" SelectionChanged="WorkspaceNavigationChanged">
            <ComboBoxItem Content="Basic Mod Builder" Tag="basic" /><ComboBoxItem Content="Game Knowledge" Tag="game-knowledge" /><ComboBoxItem Content="GECK Intent Builder" Tag="geck-intent" /><ComboBoxItem Content="Plugin Mod Workbench" Tag="plugin-workbench" /><ComboBoxItem Content="Legacy Mod Builder" Tag="mod-builder" /><ComboBoxItem Content="Narrative Author" Tag="narrative" /><ComboBoxItem Content="MCM Author" Tag="mcm" /><ComboBoxItem Content="JIP Author" Tag="jip" />
          </ComboBox>
          <TextBlock Text="Review" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold" Margin="0,12,0,0" />
          <ComboBox x:Name="ReviewWorkspaceComboBox" Margin="0,7,0,0" SelectionChanged="WorkspaceNavigationChanged">
            <ComboBoxItem Content="Validation" Tag="validation" /><ComboBoxItem Content="Capabilities" Tag="capabilities" /><ComboBoxItem Content="xEdit Audit" Tag="xedit" /><ComboBoxItem Content="Plugin Intake" Tag="plugin-intake" /><ComboBoxItem Content="GECK Handoff" Tag="geck" /><ComboBoxItem Content="Project Outputs" Tag="outputs" /><ComboBoxItem Content="Release Candidate" Tag="candidate" />
          </ComboBox>
          <TextBlock Text="System" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold" Margin="0,12,0,0" />
          <ComboBox x:Name="SystemWorkspaceComboBox" Margin="0,7,0,0" SelectionChanged="WorkspaceNavigationChanged">
            <ComboBoxItem Content="Dashboard" Tag="dashboard" /><ComboBoxItem Content="New Project" Tag="new-project" /><ComboBoxItem Content="Settings" Tag="settings" /><ComboBoxItem Content="Advanced Logs" Tag="logs" />
          </ComboBox>
          <Button x:Name="RefreshButton"
                  Margin="0,18,0,0"
                  Content="Refresh Backend"
                  Click="RefreshBackendClicked" />
          <Button Content="Open Publish Folder"
                  Margin="0,10,0,0"
                  Click="OpenPublishFolderClicked" />
          <Button Content="Open App Log"
                  Margin="0,10,0,0"
                  Click="OpenAppLogClicked" />
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3">
          <TextBlock Text="forge.exe"
                     Foreground="{StaticResource TextMuted}"
                     FontSize="12"
                     FontWeight="Bold" />
          <TextBlock x:Name="ForgePathTextBlock"
                     Text="Resolving..."
                     Margin="0,8,0,0"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="30,28,30,28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock Text="WastelandForge project studio"
                     Foreground="{StaticResource TextPrimary}"
                     FontSize="30"
                     FontWeight="Bold" />
          <TextBlock Text="Author, validate, package, and review Fallout: New Vegas mod projects."
                     Foreground="{StaticResource TextMuted}"
                     Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Column="1"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderMuted}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="Backend version"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12"
                       FontWeight="Bold" />
            <TextBlock x:Name="VersionTextBlock"
                       Text="Pending"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15"
                       Margin="0,5,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="1"
              Margin="0,24,0,20"
              Background="{StaticResource PanelBackground}"
              BorderBrush="{StaticResource BorderMuted}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Project root"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12"
                       FontWeight="Bold" />
            <TextBox x:Name="ProjectPathTextBox"
                     Margin="0,8,0,0"
                     MinWidth="420"
                     TextChanged="ProjectPathChanged" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="Browse"
                  Margin="14,21,0,0"
                  VerticalAlignment="Top"
                  Click="BrowseProjectClicked" />
          <Button x:Name="ValidateButton"
                  Grid.Column="2"
                  Content="Validate"
                  Style="{StaticResource PrimaryButton}"
                  Margin="10,21,0,0"
                  VerticalAlignment="Top"
                  Click="ValidateProjectClicked" />
        </Grid>
      </Border>

      <TabControl x:Name="MainTabControl" Grid.Row="2" SelectedIndex="1">
        <TabItem x:Name="DashboardTabItem" Header="Dashboard">
          <Grid Margin="0,18,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="2*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,14,0">
              <StackPanel>
                <TextBlock Text="Backend"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="Bold" />
                <TextBlock x:Name="BackendDetailTextBlock"
                           Text="Waiting for forge.exe --version"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0" />
                <TextBlock Text="The app shell talks to the bundled Forge executable instead of duplicating validation logic."
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,12,0,0" />
              </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,14,0">
              <StackPanel>
                <TextBlock Text="Capabilities"
                           Foreground="{StaticResource InfoBrush}"
                           FontWeight="Bold" />
                <TextBlock x:Name="CapabilityStatusTextBlock"
                           Text="Waiting for capabilities list"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0" />
                <TextBlock x:Name="CapabilitySummaryTextBlock"
                           Text="No catalogue response yet."
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,12,0,0" />
                <Button x:Name="DashboardDoctorScanButton"
                        Content="Scan Environment"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Left"
                        Click="ScanEnvironmentClicked" />
              </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
              <StackPanel>
                <TextBlock Text="Validation"
                           Foreground="{StaticResource OkBrush}"
                           FontWeight="Bold" />
                <TextBlock x:Name="ValidationStatusTextBlock"
                           Text="Not run"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0" />
                <TextBlock x:Name="ValidationSummaryTextBlock"
                           Text="Select a project and run validation."
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,12,0,0" />
              </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,18,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.15*" />
                  <ColumnDefinition Width="1.85*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <TextBlock Text="MCM package"
                             Foreground="{StaticResource AccentBrush}"
                             FontWeight="Bold" />
                  <TextBlock x:Name="BuilderStatusTextBlock"
                             Text="Ready"
                             Foreground="{StaticResource TextPrimary}"
                             FontSize="20"
                             FontWeight="SemiBold"
                             Margin="0,10,0,0" />
                  <TextBlock x:Name="BuilderSummaryTextBlock"
                             Text="Run the full build to create and verify dist/mcm-json/package.zip."
                             Foreground="{StaticResource TextMuted}"
                             Margin="0,12,0,0" />
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                  <Button x:Name="BuildBasicModButton"
                          Content="Build Basic Mod"
                          Style="{StaticResource PrimaryButton}"
                          Margin="0,0,10,10"
                          Click="BuildBasicModClicked" />
                  <Button x:Name="GenerateMcmButton"
                          Content="Generate MCM"
                          Margin="0,0,10,10"
                          Click="GenerateMcmClicked" />
                  <Button x:Name="PackageMcmButton"
                          Content="Package ZIP"
                          Margin="0,0,10,10"
                          Click="PackageMcmClicked" />
                  <Button x:Name="VerifyPackageButton"
                          Content="Verify Package"
                          Margin="0,0,10,10"
                          Click="VerifyPackageClicked" />
                  <Button x:Name="OpenPackageButton"
                          Content="Open Package"
                          Margin="0,0,0,10"
                          Click="OpenPackageClicked" />
                </WrapPanel>
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <TabItem x:Name="ModBuilderTabItem" Header="Mod Builder">
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="360" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,18,0">
              <StackPanel>
                <TextBlock Text="Workflow"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="Bold" />
                <Button x:Name="ModBuilderBuildButton"
                        Content="Build Basic Mod"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,16,0,0"
                        Click="BuildBasicModClicked" />
                <Button x:Name="ModBuilderDemoButton"
                        Content="Reset Demo Project"
                        Margin="0,10,0,0"
                        Click="ResetDemoProjectClicked" />
                <Button x:Name="ModBuilderValidateButton"
                        Content="Validate"
                        Margin="0,10,0,0"
                        Click="ValidateProjectClicked" />
                <Button x:Name="PostCreateCapabilityScanButton"
                        Content="Scan Project Capabilities"
                        Margin="0,10,0,0"
                        IsEnabled="False"
                        Click="PostCreateCapabilityScanClicked" />
                <Button x:Name="PostCreateDocsButton"
                        Content="Generate Project Docs"
                        Margin="0,10,0,0"
                        IsEnabled="False"
                        Click="PostCreateDocsClicked" />
                <Button x:Name="OpenDocsFolderButton"
                        Content="Open Docs Folder"
                        Margin="0,10,0,0"
                        IsEnabled="False"
                        Click="OpenDocsFolderClicked" />
                <Button x:Name="ModBuilderGenerateButton"
                        Content="Generate MCM"
                        Margin="0,10,0,0"
                        Click="GenerateMcmClicked" />
                <Button x:Name="ModBuilderPackageButton"
                        Content="Package ZIP"
                        Margin="0,10,0,0"
                        Click="PackageMcmClicked" />
                <Button x:Name="ModBuilderVerifyButton"
                        Content="Verify Package"
                        Margin="0,10,0,0"
                        Click="VerifyPackageClicked" />
                <Button x:Name="ModBuilderOpenPackageButton"
                        Content="Open Package Folder"
                        Margin="0,10,0,0"
                        Click="OpenPackageClicked" />

                <Separator Margin="0,22,0,18" />

                <TextBlock Text="Project docs"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           FontWeight="Bold" />
                <TextBlock x:Name="DocsStatusTextBlock"
                           Text="Not generated"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0" />
                <TextBlock x:Name="DocsPathTextBlock"
                           Text="generated/docs"
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />

                <Separator Margin="0,22,0,18" />

                <TextBlock Text="Package"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           FontWeight="Bold" />
                <TextBlock x:Name="PackageStatusTextBlock"
                           Text="Not built"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0" />
                <TextBlock x:Name="PackagePathTextBlock"
                           Text="dist/mcm-json/package.zip"
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="PackageEntriesTextBlock"
                           Text="No package entries loaded."
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,8,0,0" />
              </StackPanel>
            </Border>

            <TabControl Grid.Column="1">
              <TabItem Header="Command Output">
                <TextBox x:Name="BuilderOutputTextBox"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="13"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         TextWrapping="NoWrap" />
              </TabItem>
              <TabItem x:Name="DocsIndexTabItem" Header="Docs Index" IsEnabled="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="16">
                    <TextBlock x:Name="DocsIndexSummaryTextBlock"
                               Text="Generate project docs to load the reference index."
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,8" />
                    <TextBox x:Name="DocsIndexFilterTextBox"
                             Margin="0,0,0,14"
                             ToolTip="Filter reference title, ID, kind, source, version, or description"
                             TextChanged="DocsIndexFilterChanged" />
                    <Border Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderMuted}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,18">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="220" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock x:Name="SelectedDocsReferenceTitleTextBlock" Text="No reference selected" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                          <TextBlock x:Name="SelectedDocsReferenceIdTextBlock" Text="Select an entry below." Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                          <TextBlock x:Name="SelectedDocsReferenceSourceTextBlock" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                          <TextBlock x:Name="SelectedDocsReferencePathTextBlock" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="OpenDocsReferenceButton"
                                Grid.Column="1"
                                Content="Open Reference"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                Click="OpenDocsReferenceClicked" />
                        <TextBox x:Name="MarkdownPreviewTextBox"
                                 Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 Margin="0,14,0,0"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 Text="Select a reference to preview its generated Markdown."
                                 TextWrapping="NoWrap" />
                      </Grid>
                    </Border>
                    <ItemsControl x:Name="DocsIndexSectionsItemsControl">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding Entries}"
                                     Margin="0,8,0,0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionChanged="DocsReferenceSelectionChanged">
                              <ListBox.ItemTemplate>
                                <DataTemplate>
                                  <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="220" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                      <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                      <TextBlock Text="{Binding Kind}" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                      <TextBlock Text="{Binding Id}" Foreground="{StaticResource TextPrimary}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                                      <TextBlock Text="{Binding Source}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                                      <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                  </Grid>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Grid>
        </TabItem>

        <TabItem x:Name="ValidationReportTabItem" Header="Validation Report">
          <Grid Margin="0,18,0,0">
            <TextBox x:Name="ValidationOutputTextBox"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="13"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     TextWrapping="NoWrap" />
          </Grid>
        </TabItem>

        <TabItem x:Name="CapabilitiesTabItem" Header="Capabilities">
          <Grid Margin="0,18,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Doctor readiness" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="DoctorSummaryTextBlock"
                           Text="Save local setup paths, then scan the environment."
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,5,0,0" />
              </StackPanel>
              <Button x:Name="CapabilitiesDoctorScanButton"
                      Grid.Column="1"
                      Content="Scan Environment"
                      Style="{StaticResource PrimaryButton}"
                      Click="ScanEnvironmentClicked" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
              <ItemsControl x:Name="DoctorAreasItemsControl">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderMuted}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="220" />
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="16" />
                          <TextBlock Text="{Binding Coverage}" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4" Padding="9,4" Background="{StaticResource PanelRaised}">
                          <TextBlock x:Name="StatusText" Text="{Binding Status}" FontWeight="SemiBold" />
                        </Border>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Actions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding}" Margin="0,0,0,5" Foreground="{StaticResource TextSecondary}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Grid.Column="3"
                                Content="View Evidence"
                                Tag="{Binding Id}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Top"
                                Click="ViewDoctorEvidenceClicked" />
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Status}" Value="ready">
                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource OkBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="action-needed">
                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="unknown">
                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource TextMuted}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border x:Name="ProviderEvidencePanel"
                      Visibility="Collapsed"
                      Background="{StaticResource PanelRaised}"
                      BorderBrush="{StaticResource BorderMuted}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="18"
                      Margin="0,6,0,10">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProviderEvidenceTitleTextBlock"
                               Text="Provider evidence"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <Button Grid.Column="1"
                            Content="Configure Paths"
                            Click="ConfigurePathsClicked" />
                  </Grid>
                  <TextBlock Text="Physical path evidence reported by forge.exe. No tools are executed."
                             Foreground="{StaticResource TextMuted}"
                             Margin="0,5,0,14" />
                  <ItemsControl x:Name="ProviderEvidenceItemsControl">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderMuted}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14"
                                Margin="0,0,0,10">
                          <StackPanel>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                              <Button Grid.Column="1"
                                      Content="Explain"
                                      Tag="{Binding Id}"
                                      Padding="12,5"
                                      Click="ExplainProviderClicked" />
                            </Grid>
                            <TextBlock Margin="0,4,0,8">
                              <Run Text="{Binding Status}" />
                              <Run Text="  |  " />
                              <Run Text="{Binding InstallScope}" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Evidence}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <StackPanel Margin="0,4,0,5">
                                    <TextBlock Foreground="{StaticResource TextMuted}">
                                      <Run Text="{Binding Status}" />
                                      <Run Text="  |  " />
                                      <Run Text="{Binding DetectorKind}" />
                                      <Run Text="  |  " />
                                      <Run Text="{Binding Scope}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Path}" FontFamily="Cascadia Mono, Consolas" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Message}" Margin="0,2,0,0" />
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border x:Name="ProviderExplanationPanel"
                          Visibility="Collapsed"
                          Background="{StaticResource PanelBackground}"
                          BorderBrush="{StaticResource BorderMuted}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="14">
                    <StackPanel>
                      <TextBlock x:Name="ProviderExplanationTitleTextBlock"
                                 Text="Provider explanation"
                                 Foreground="{StaticResource TextPrimary}"
                                 FontWeight="SemiBold" />
                      <TextBlock x:Name="ProviderExplanationStatusTextBlock"
                                 Text="Waiting"
                                 Foreground="{StaticResource TextMuted}"
                                 Margin="0,4,0,8" />
                      <TextBlock x:Name="ProviderExplanationDescriptionTextBlock"
                                 Foreground="{StaticResource TextSecondary}"
                                 Margin="0,0,0,10" />
                      <TextBlock Text="Next actions" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                      <ItemsControl x:Name="ProviderExplanationActionsItemsControl" Margin="0,5,0,10">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,0,0,4" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="Related capabilities" Foreground="{StaticResource InfoBrush}" FontWeight="SemiBold" />
                      <ItemsControl x:Name="ProviderExplanationCapabilitiesItemsControl" Margin="0,5,0,10">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{StaticResource PanelRaised}" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                              <TextBlock Text="{Binding}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="Evidence groups" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                      <ItemsControl x:Name="ProviderExplanationGroupsItemsControl" Margin="0,5,0,8">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                              <TextBlock>
                                <Run Text="{Binding Title}" FontWeight="SemiBold" />
                                <Run Text="  |  " />
                                <Run Text="{Binding Status}" />
                                <Run Text="  |  " />
                                <Run Text="{Binding InstallScope}" />
                              </TextBlock>
                              <ItemsControl ItemsSource="{Binding Evidence}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <StackPanel Margin="0,4,0,4">
                                      <TextBlock Foreground="{StaticResource TextMuted}">
                                        <Run Text="{Binding Status}" />
                                        <Run Text="  |  " />
                                        <Run Text="{Binding DetectorKind}" />
                                        <Run Text="  |  " />
                                        <Run Text="{Binding Scope}" />
                                      </TextBlock>
                                      <TextBlock Text="{Binding Path}" FontFamily="Cascadia Mono, Consolas" />
                                      <TextBlock Text="{Binding Message}" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Expander Header="Advanced Explanation JSON">
                        <TextBox x:Name="ProviderExplanationTextBox"
                                 Height="220"
                                 Margin="0,8,0,0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="Cascadia Mono, Consolas"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" />
                      </Expander>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
              </StackPanel>
            </ScrollViewer>
            <Expander Grid.Row="2" Header="Advanced JSON" Margin="0,8,0,0">
              <TextBox x:Name="CapabilityJsonTextBox"
                       Height="240"
                       Margin="0,8,0,0"
                       AcceptsReturn="True"
                       AcceptsTab="True"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="13"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       IsReadOnly="True"
                       TextWrapping="NoWrap" />
            </Expander>
          </Grid>
        </TabItem>

        <TabItem x:Name="SettingsTabItem" Header="Settings">
          <ScrollViewer Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="920" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
                <TextBlock Text="Local setup" Foreground="{StaticResource TextPrimary}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Machine-specific paths are stored locally and are not written into the Forge project."
                           Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" />
              </StackPanel>

              <Border Grid.Row="1" Grid.ColumnSpan="3"
                      Background="{StaticResource PanelRaised}"
                      BorderBrush="{StaticResource BorderMuted}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="16"
                      Margin="0,0,0,14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Setup readiness" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="17" />
                    <TextBlock x:Name="SetupReadinessTextBlock"
                               Text="Checking local path configuration..."
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,5,0,0" />
                  </StackPanel>
                  <Button x:Name="SaveAndScanButton"
                          Grid.Column="1"
                          Content="Save &amp; Scan"
                          Style="{StaticResource PrimaryButton}"
                          Click="SaveAndScanClicked" />
                </Grid>
              </Border>

              <TextBlock Grid.Row="2" Text="Project root" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="SettingsProjectRootTextBox" Grid.Row="2" Grid.Column="1" Margin="12,5" TextChanged="SettingsPathChanged" />
              <Button Grid.Row="2" Grid.Column="2" Content="Browse" Margin="8,5,0,5" Tag="project" Click="BrowseSettingsFolderClicked" />

              <TextBlock Grid.Row="3" Text="Fallout: New Vegas root" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="GameRootTextBox" Grid.Row="3" Grid.Column="1" Margin="12,5" TextChanged="SettingsPathChanged" />
              <Button Grid.Row="3" Grid.Column="2" Content="Browse" Margin="8,5,0,5" Tag="game" Click="BrowseSettingsFolderClicked" />

              <TextBlock Grid.Row="4" Text="Data root" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="DataRootTextBox" Grid.Row="4" Grid.Column="1" Margin="12,5" TextChanged="SettingsPathChanged" />
              <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Margin="8,5,0,5">
                <Button x:Name="UseGameDataButton"
                        Content="Use Game\Data"
                        Margin="0,0,8,0"
                        Click="UseGameDataClicked" />
                <Button Content="Browse" Tag="data" Click="BrowseSettingsFolderClicked" />
              </StackPanel>

              <TextBlock Grid.Row="5" Text="Mod Organizer 2" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="Mo2PathTextBox" Grid.Row="5" Grid.Column="1" Margin="12,5" TextChanged="SettingsPathChanged" />
              <Button Grid.Row="5" Grid.Column="2" Content="Browse" Margin="8,5,0,5" Tag="mo2" Click="BrowseSettingsFileClicked" />

              <TextBlock Grid.Row="6" Text="MO2 mods folder" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="SettingsMo2ModsRootTextBox" Grid.Row="6" Grid.Column="1" Margin="12,5" TextChanged="SettingsPathChanged" />
              <Button Grid.Row="6" Grid.Column="2" Content="Browse" Margin="8,5,0,5" Tag="mo2mods" Click="BrowseSettingsFolderClicked" />

              <TextBlock Grid.Row="7" Text="GECK" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="GeckPathTextBox" Grid.Row="7" Grid.Column="1" Margin="12,5" TextChanged="SettingsPathChanged" />
              <Button Grid.Row="7" Grid.Column="2" Content="Browse" Margin="8,5,0,5" Tag="geck" Click="BrowseSettingsFileClicked" />

              <TextBlock Grid.Row="8" Text="xEdit" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="XEditPathTextBox" Grid.Row="8" Grid.Column="1" Margin="12,5" TextChanged="SettingsPathChanged" />
              <Button Grid.Row="8" Grid.Column="2" Content="Browse" Margin="8,5,0,5" Tag="xedit" Click="BrowseSettingsFileClicked" />

              <Grid Grid.Row="9" Grid.ColumnSpan="3" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SettingsStatusTextBlock" Text="Settings have not been changed." Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Reset" Margin="0,0,10,0" Click="ResetSettingsClicked" />
                <Button x:Name="SaveSettingsButton" Grid.Column="2" Content="Save Settings" Style="{StaticResource PrimaryButton}" Click="SaveSettingsClicked" />
              </Grid>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="BasicModBuilderTabItem" Header="Basic Mod Builder">
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="390" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
              <StackPanel>
                <TextBlock Text="Basic Mod Builder" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Parent folder" Foreground="{StaticResource TextMuted}" Margin="0,16,0,0" /><TextBox x:Name="BasicModParentTextBox" TextChanged="BasicModInputChanged" />
                <Button Content="Choose Parent Folder" Margin="0,7,0,0" Click="BrowseBasicModParentClicked" />
                <TextBlock Text="Project and mod name" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="BasicModNameTextBox" TextChanged="BasicModInputChanged" />
                <TextBlock Text="MCM menu title" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="BasicModMenuTitleTextBox" Text="My Mod Settings" TextChanged="BasicModInputChanged" />
                <TextBlock Text="Toggle label" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="BasicModSettingLabelTextBox" Text="Enable feature" TextChanged="BasicModInputChanged" />
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,5,0"><TextBlock Text="INI section" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="BasicModIniSectionTextBox" Text="General" TextChanged="BasicModInputChanged" /></StackPanel>
                  <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="INI key" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="BasicModIniKeyTextBox" Text="bEnabled" TextChanged="BasicModInputChanged" /></StackPanel>
                </Grid>
                <CheckBox x:Name="BasicModEnabledCheckBox" Content="Enabled by default" Margin="0,12,0,0" Checked="BasicModInputChanged" Unchecked="BasicModInputChanged" />
                <CheckBox x:Name="BasicModIncludeJipCheckBox" Content="Include JIP LN startup script" Margin="0,12,0,0" IsChecked="True" Checked="BasicModInputChanged" Unchecked="BasicModInputChanged" />
                <TextBlock Text="JIP script summary" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="BasicModJipSummaryTextBox" Text="Project bootstrap script." TextChanged="BasicModInputChanged" />
                <TextBlock Text="JIP opaque source" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" /><TextBox x:Name="BasicModJipBodyTextBox" Text="; Add JIP LN startup logic here." AcceptsReturn="True" Height="72" TextChanged="BasicModInputChanged" />
                <WrapPanel Margin="0,18,0,0"><Button x:Name="PreviewBasicModButton" Content="Preview" Click="PreviewBasicModClicked" /><Button x:Name="CreateBasicModButton" Content="Create Mod" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="8,0,0,0" Click="CreateBasicModClicked" /><Button x:Name="CancelBasicModButton" Content="Cancel" IsEnabled="False" Margin="8,0,0,0" Click="CancelBasicModClicked" /></WrapPanel>
                <TextBlock x:Name="BasicModStatusTextBlock" Text="Enter project details and preview." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,12,0,0" />
                <WrapPanel Margin="0,12,0,0"><Button x:Name="OpenBasicModProjectButton" Content="Open Project" IsEnabled="False" Click="OpenBasicModProjectClicked" /><Button x:Name="OpenBasicModFomodButton" Content="Open FOMOD ZIP" IsEnabled="False" Margin="8,0,0,0" Click="OpenBasicModFomodClicked" /></WrapPanel>
              </StackPanel>
            </ScrollViewer>
            <TextBox x:Name="BasicModOutputTextBox" Grid.Column="1" AcceptsReturn="True" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
          </Grid>
        </TabItem>

        <TabItem x:Name="GeckIntentBuilderTabItem" Header="GECK Intent Builder" AutomationProperties.AutomationId="GeckIntentBuilderTabItem">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="440" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,18,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="GECK Intent Builder" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="GeckIntentOperationStateTextBlock" AutomationProperties.AutomationId="GeckIntentOperationStateTextBlock" Text="Not loaded" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,5,0,0" />
                  </StackPanel>
                  <Button x:Name="RefreshGeckIntentBuilderButton" AutomationProperties.AutomationId="RefreshGeckIntentBuilderButton" Grid.Column="1" Content="Refresh" Click="RefreshGeckIntentBuilderClicked" />
                </Grid>

                <TextBlock Text="Plugin" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,18,0,0" />
                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,5,0"><TextBlock Text="Filename" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="GeckIntentPluginFileNameTextBox" AutomationProperties.AutomationId="GeckIntentPluginFileNameTextBox" TextChanged="GeckIntentBuilderInputChanged" /></StackPanel>
                  <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Author" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="GeckIntentAuthorTextBox" AutomationProperties.AutomationId="GeckIntentAuthorTextBox" TextChanged="GeckIntentBuilderInputChanged" /></StackPanel>
                </Grid>
                <TextBlock Text="Summary" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><TextBox x:Name="GeckIntentSummaryTextBox" AutomationProperties.AutomationId="GeckIntentSummaryTextBox" TextChanged="GeckIntentBuilderInputChanged" />

                <TextBlock Text="Environment" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,16,0,0" />
                <ComboBox x:Name="GeckIntentEnvironmentModeComboBox" AutomationProperties.AutomationId="GeckIntentEnvironmentModeComboBox" Margin="0,7,0,0" SelectionChanged="GeckIntentBuilderInputChanged"><ComboBoxItem Content="Physical Data" Tag="physical-data" IsSelected="True" /><ComboBoxItem Content="MO2 (deferred)" Tag="mo2" /></ComboBox>
                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="GeckIntentOutputRootTextBox" AutomationProperties.AutomationId="GeckIntentOutputRootTextBox" TextChanged="GeckIntentBuilderInputChanged" />
                  <Button x:Name="BrowseGeckIntentOutputRootButton" AutomationProperties.AutomationId="BrowseGeckIntentOutputRootButton" Grid.Column="1" Content="Browse" Margin="8,0,0,0" Click="BrowseGeckIntentOutputRootClicked" />
                </Grid>

                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Provider evidence" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" /><Button x:Name="BrowseGeckIntentProviderEvidenceButton" Grid.Column="1" Content="Attach evidence" Click="BrowseGeckIntentProviderEvidenceClicked" /></Grid>
                <DataGrid x:Name="GeckIntentProvidersDataGrid" AutomationProperties.AutomationId="GeckIntentProvidersDataGrid" Height="150" Margin="0,7,0,0" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="GeckIntentProviderSelectionChanged" CellEditEnding="GeckIntentBuilderGridCellEditEnding">
                  <DataGrid.Columns><DataGridTextColumn Header="Role" Binding="{Binding Role}" IsReadOnly="True" Width="130" /><DataGridTextColumn Header="Evidence" Binding="{Binding EvidencePath, UpdateSourceTrigger=PropertyChanged}" Width="*" /><DataGridCheckBoxColumn Header="Attested" Binding="{Binding Attested}" Width="75" /></DataGrid.Columns>
                </DataGrid>
                <Grid Margin="0,7,0,0" DataContext="{Binding SelectedItem, ElementName=GeckIntentProvidersDataGrid}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="GeckIntentProviderEvidencePathTextBox" AutomationProperties.AutomationId="GeckIntentProviderEvidencePathTextBox" Text="{Binding EvidencePath, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="GeckIntentBuilderInputChanged" /><CheckBox x:Name="GeckIntentProviderAttestedCheckBox" AutomationProperties.AutomationId="GeckIntentProviderAttestedCheckBox" Grid.Column="1" Content="Locally attested" Margin="10,0,0,0" IsChecked="{Binding Attested}" Click="GeckIntentBuilderInputChanged" /></Grid>

                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Resolved evidence" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" /><Button x:Name="AddGeckIntentItemResolutionButton" AutomationProperties.AutomationId="AddGeckIntentItemResolutionButton" Grid.Column="1" Content="Add item" Click="AddGeckIntentItemResolutionClicked" /><Button x:Name="RemoveGeckIntentItemResolutionButton" AutomationProperties.AutomationId="RemoveGeckIntentItemResolutionButton" Grid.Column="2" Content="Remove" Margin="6,0,0,0" Click="RemoveGeckIntentItemResolutionClicked" /><Button x:Name="BrowseGeckIntentResolutionEvidenceButton" Grid.Column="3" Content="Attach" Margin="6,0,0,0" Click="BrowseGeckIntentResolutionEvidenceClicked" /></Grid>
                <DataGrid x:Name="GeckIntentResolutionsDataGrid" AutomationProperties.AutomationId="GeckIntentResolutionsDataGrid" Height="210" Margin="0,7,0,0" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="GeckIntentResolutionSelectionChanged" CellEditEnding="GeckIntentBuilderGridCellEditEnding" HorizontalScrollBarVisibility="Auto">
                  <DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="140" /><DataGridTextColumn Header="Kind" Binding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" Width="105" /><DataGridTextColumn Header="EditorID" Binding="{Binding EditorId, UpdateSourceTrigger=PropertyChanged}" Width="130" /><DataGridTextColumn Header="FormID" Binding="{Binding FormId, UpdateSourceTrigger=PropertyChanged}" Width="85" /><DataGridTextColumn Header="Sig" Binding="{Binding Signature, UpdateSourceTrigger=PropertyChanged}" Width="55" /><DataGridTextColumn Header="Status" Binding="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Width="85" /><DataGridTextColumn Header="Evidence" Binding="{Binding EvidencePath, UpdateSourceTrigger=PropertyChanged}" Width="180" /><DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="55" /></DataGrid.Columns>
                </DataGrid>
                <Grid Margin="0,7,0,0" DataContext="{Binding SelectedItem, ElementName=GeckIntentResolutionsDataGrid}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel Margin="0,0,4,4"><TextBlock Text="ID" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="GeckIntentResolutionIdTextBox" AutomationProperties.AutomationId="GeckIntentResolutionIdTextBox" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="GeckIntentBuilderInputChanged" /></StackPanel>
                  <StackPanel Grid.Column="1" Margin="4,0,4,4"><TextBlock Text="Kind" Foreground="{StaticResource TextMuted}" /><ComboBox x:Name="GeckIntentResolutionKindComboBox" AutomationProperties.AutomationId="GeckIntentResolutionKindComboBox" SelectedValuePath="Tag" SelectedValue="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" DropDownClosed="GeckIntentBuilderDropDownClosed"><ComboBoxItem Content="Item" Tag="item" /><ComboBoxItem Content="Cell" Tag="cell" /><ComboBoxItem Content="Worldspace" Tag="worldspace" /><ComboBoxItem Content="Container base" Tag="container-base" /></ComboBox></StackPanel>
                  <StackPanel Grid.Column="2" Margin="4,0,4,4"><TextBlock Text="EditorID" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="GeckIntentResolutionEditorIdTextBox" AutomationProperties.AutomationId="GeckIntentResolutionEditorIdTextBox" Text="{Binding EditorId, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="GeckIntentBuilderInputChanged" /></StackPanel>
                  <StackPanel Grid.Column="3" Margin="4,0,0,4"><TextBlock Text="FormID" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="GeckIntentResolutionFormIdTextBox" AutomationProperties.AutomationId="GeckIntentResolutionFormIdTextBox" Text="{Binding FormId, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="GeckIntentBuilderInputChanged" /></StackPanel>
                  <StackPanel Grid.Row="1" Margin="0,0,4,4"><TextBlock Text="Signature" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="GeckIntentResolutionSignatureTextBox" AutomationProperties.AutomationId="GeckIntentResolutionSignatureTextBox" Text="{Binding Signature, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="GeckIntentBuilderInputChanged" /></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,4,4"><TextBlock Text="Status" Foreground="{StaticResource TextMuted}" /><ComboBox x:Name="GeckIntentResolutionStatusComboBox" AutomationProperties.AutomationId="GeckIntentResolutionStatusComboBox" SelectedValuePath="Tag" SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}" DropDownClosed="GeckIntentBuilderDropDownClosed"><ComboBoxItem Content="Provisional" Tag="provisional" /><ComboBoxItem Content="Local verified" Tag="local-verified" /></ComboBox></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,0,4,4"><TextBlock Text="Quantity" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="GeckIntentResolutionQuantityTextBox" AutomationProperties.AutomationId="GeckIntentResolutionQuantityTextBox" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="GeckIntentBuilderInputChanged" /></StackPanel>
                  <StackPanel Grid.Row="2" Grid.ColumnSpan="4"><TextBlock Text="Evidence" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="GeckIntentResolutionEvidencePathTextBox" AutomationProperties.AutomationId="GeckIntentResolutionEvidencePathTextBox" Text="{Binding EvidencePath, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="GeckIntentBuilderInputChanged" /></StackPanel>
                </Grid>

                <TextBlock Text="Authoring declaration" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,16,0,0" />
                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,5,0"><TextBlock Text="Container EditorID" Foreground="{StaticResource TextMuted}" /><TextBox x:Name="GeckIntentContainerEditorIdTextBox" AutomationProperties.AutomationId="GeckIntentContainerEditorIdTextBox" TextChanged="GeckIntentBuilderInputChanged" /></StackPanel>
                  <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Strategy" Foreground="{StaticResource TextMuted}" /><ComboBox x:Name="GeckIntentContainerStrategyComboBox" AutomationProperties.AutomationId="GeckIntentContainerStrategyComboBox" SelectionChanged="GeckIntentBuilderInputChanged"><ComboBoxItem Content="New container" Tag="new" IsSelected="True" /><ComboBoxItem Content="Approved clone" Tag="clone-approved" /></ComboBox></StackPanel>
                </Grid>
                <TextBlock Text="Reference EditorID" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" /><TextBox x:Name="GeckIntentReferenceEditorIdTextBox" AutomationProperties.AutomationId="GeckIntentReferenceEditorIdTextBox" TextChanged="GeckIntentBuilderInputChanged" />
