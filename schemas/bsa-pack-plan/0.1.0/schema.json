{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wastelandforge.dev/fnv/bsa-pack-plan/0.1.0/schema.json",
  "title": "WastelandForge BSA Pack Plan 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "kind", "target", "tool", "projectId", "associationPlugin", "sourcePackage", "archives", "bsaCreated", "externalToolExecuted"],
  "properties": {
    "formatVersion": { "const": "0.1" },
    "kind": { "const": "wastelandforge.bsa-pack-plan" },
    "target": { "const": "bsa-plan" },
    "tool": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "const": "WastelandForge" }, "version": { "type": "string", "minLength": 1 } } },
    "projectId": { "type": ["string", "null"] },
    "associationPlugin": { "type": "object", "additionalProperties": false, "required": ["dataPath", "sha256"], "properties": { "dataPath": { "type": "string", "pattern": "^[^/\\\\]+\\.(esp|esm)$" }, "sha256": { "$ref": "#/$defs/sha" } } },
    "sourcePackage": { "type": "object", "additionalProperties": false, "required": ["manifest", "archive"], "properties": { "manifest": { "$ref": "#/$defs/fileDigest" }, "archive": { "$ref": "#/$defs/fileDigest" } } },
    "archives": { "type": "array", "items": { "$ref": "#/$defs/archive" } },
    "bsaCreated": { "const": false },
    "externalToolExecuted": { "const": false }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fileDigest": { "type": "object", "additionalProperties": false, "required": ["path", "length", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "length": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha" } } },
    "archive": { "type": "object", "additionalProperties": false, "required": ["file", "compress", "entryCount", "archiveFlags", "fileFlags", "entries"], "properties": { "file": { "type": "string", "pattern": "^[^/\\\\]+ - (Textures|Meshes|Sounds|Voices|Misc)\\.bsa$" }, "compress": { "const": false }, "entryCount": { "type": "integer", "minimum": 1 }, "archiveFlags": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "enum": ["include-directory-names", "include-file-names", "retain-directory-names", "retain-file-names", "embed-file-names"] } }, "fileFlags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["dds", "egm", "egt", "lip", "lst", "nif", "ogg", "rdt", "spt", "wav"] } }, "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } } } },
    "entry": { "type": "object", "additionalProperties": false, "required": ["component", "dataPath", "archivePath", "classification", "length", "sha256", "requiredPacked"], "properties": { "component": { "type": "string", "minLength": 1 }, "dataPath": { "type": "string", "minLength": 1 }, "archivePath": { "type": "string", "minLength": 1 }, "classification": { "enum": ["pack-textures", "pack-meshes", "pack-audio", "pack-voices", "pack-misc"] }, "length": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha" }, "requiredPacked": { "type": "boolean" } } }
  }
}
