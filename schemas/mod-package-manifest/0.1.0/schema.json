{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wastelandforge.dev/fnv/mod-package-manifest/0.1.0/schema.json",
  "title": "WastelandForge Combined Mod Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "kind", "packageType", "command", "target", "tool", "project", "components", "generators", "sources", "entries", "archive", "outputOwnership"],
  "properties": {
    "formatVersion": { "const": "0.1" },
    "kind": { "const": "wastelandforge.mod-package-manifest" },
    "packageType": { "const": "wastelandforge/mod-package/v1" },
    "command": { "const": "package" },
    "target": { "const": "mod-package" },
    "tool": { "$ref": "#/$defs/tool" },
    "project": { "$ref": "#/$defs/project" },
    "components": { "$ref": "#/$defs/components" },
    "generators": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/generator" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/digest" } },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } },
    "archive": { "$ref": "#/$defs/archive" },
    "outputOwnership": { "type": "object", "additionalProperties": false, "required": ["root", "ownedByForge", "replaced"], "properties": { "root": { "$ref": "#/$defs/path" }, "ownedByForge": { "const": true }, "replaced": { "type": "boolean" } } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\][^\\\\]*(?:/[^/\\\\]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tool": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "const": "WastelandForge" }, "version": { "$ref": "#/$defs/text" } } },
    "project": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "$ref": "#/$defs/text" }, "version": { "$ref": "#/$defs/text" } } },
    "components": { "type": "object", "additionalProperties": false, "required": ["included", "excluded"], "properties": { "included": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["mcm-json", "jip-scripts"] } }, "excluded": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } } } },
    "generator": { "type": "object", "additionalProperties": false, "required": ["id", "version", "target"], "properties": { "id": { "$ref": "#/$defs/text" }, "version": { "$ref": "#/$defs/text" }, "target": { "enum": ["mcm-json", "jip-scripts"] } } },
    "digest": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "length"], "properties": { "path": { "$ref": "#/$defs/text" }, "sha256": { "$ref": "#/$defs/sha256" }, "length": { "type": "integer", "minimum": 0 } } },
    "entry": { "type": "object", "additionalProperties": false, "required": ["component", "kind", "id", "sourceFile", "dataPath", "stagedPath", "mediaType", "length", "sha256"], "properties": { "component": { "enum": ["mcm-json", "jip-scripts"] }, "kind": { "$ref": "#/$defs/text" }, "id": { "$ref": "#/$defs/text" }, "sourceFile": { "$ref": "#/$defs/text" }, "dataPath": { "$ref": "#/$defs/path" }, "stagedPath": { "$ref": "#/$defs/path" }, "mediaType": { "$ref": "#/$defs/text" }, "length": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "archive": { "type": "object", "additionalProperties": false, "required": ["path", "mediaType", "compression", "entryCount", "length", "sha256", "timestampSource", "entriesValidated"], "properties": { "path": { "const": "package.zip" }, "mediaType": { "const": "application/zip" }, "compression": { "const": "store" }, "entryCount": { "type": "integer", "minimum": 1 }, "length": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "timestampSource": { "$ref": "#/$defs/text" }, "entriesValidated": { "const": true } } }
  }
}
